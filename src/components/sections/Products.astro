---
import CTAButton from "@components/ui/CTAButton.astro";
import SectionHeader from "@components/ui/SectionHeader.astro";
import ProductCard from "@components/ui/ProductCard.astro";
import MushyGuyHazy from "@images/mushyguyHazy.svg?raw";
import { products } from "@data/products.ts";
---

<section class="section section--dark container">
  <div class="products" data-animation="products-wrapper">
    <SectionHeader
      title="Our Products"
      text="No other shop in the world carries the same range of products that we do!"
      sectionName="product"
    />
    <div class="products-grid">
      {
        products.map((product) => (
          <ProductCard
            title={product.title}
            description={product.description}
            image={product.image}
            hasGuide={product.hasGuide}
            href={product.href}
          />
        ))
      }
      {products.length < 1 && <p>Currently Nothing on the Menu!</p>}
    </div>

    <div class="products-cta">
      <div class="products-cta-button">
        <CTAButton text="View Our Full Menu!" href="/products" />
      </div>
      <div class="products-mushy-guy">
        <Fragment set:html={MushyGuyHazy} />
      </div>
    </div>
  </div>

  <style>
    .products-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(260px, 100%), 1fr));
      align-items: stretch;
      column-gap: calc(var(--space-gutter-secondary) + 5px);
      row-gap: var(--space-gutter-primary);
      margin-block-end: var(--space-sub-section-block);
    }
    .products-cta {
      position: relative;
      display: grid;
      place-content: center;
    }
    .products-mushy-guy {
      position: absolute;
      top: -120%;
      right: calc(50% - 20rem);
      z-index: 2;
      width: 8rem;
      pointer-events: none;
      rotate: 8deg;

      @media (prefers-reduced-motion: no-preference) {
        animation: bounce 2s ease-in-out infinite;
      }
    }

    @keyframes bounce {
      0%,
      100% {
        transform: translateY(0);
      }
      50% {
        transform: translateY(-3px);
      }
    }

    /* MOBILE */
    @media (max-width: 600px) {
      .products-grid {
        grid-template-columns: unset;
        grid-auto-flow: column;
        grid-auto-columns: 85%;
        overflow-x: scroll;
        scroll-snap-type: x mandatory;
        scrollbar-width: none;
        margin-inline: calc(-1 * var(--space-section-inline));
        padding-inline: var(--space-section-inline);
        margin-block-end: var(--sp-08);
        scroll-padding-inline: var(--space-section-inline);
        mask-image: linear-gradient(
          to right,
          transparent,
          black 5%,
          black 95%,
          transparent
        );
        -webkit-mask-image: linear-gradient(
          to right,
          transparent,
          black 5%,
          black 95%,
          transparent
        );
      }
      .products-cta-button {
        display: grid;
        text-align: center;
      }
      .products-mushy-guy {
        top: -120%;
        right: calc(50% - 14rem);
        width: 6rem;
      }
    }
  </style>

  <script>
    import gsap from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    gsap.registerPlugin(ScrollTrigger);

    const productsWrapper = document.querySelector(
      '[data-animation="products-wrapper"]',
    );
    const productHeader = document.querySelector(
      '[data-animate="product-header"]',
    );
    const productCards = document.querySelectorAll(
      '[data-animation="product-card"]',
    );

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: productsWrapper,
        start: "top 80%",
      },
    });

    tl.from(productHeader, {
      opacity: 0,
      y: 20,
      duration: 0.5,
      ease: "power2.out",
    }).from(
      productCards,
      {
        opacity: 0,
        duration: 1,
        ease: "power2.out",
        stagger: 0.1,
      },
      "+=0.1",
    );
  </script>
</section>
