---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import FreeUserGuideIcon from "./FreeUserGuideIcon.astro";

interface Props {
  title: string;
  description: string;
  image: ImageMetadata;
  hasGuide: boolean;
  href: string;
}

const {
  title = "Mushroom Dispensary",
  description = "This is just default text!",
  image,
  hasGuide = false,
  href = "/products",
} = Astro.props;
---

<a class="product-card-link" href={href} data-animation="product-card">
  <div class="product-card section--light">
    <div class="product-card-image">
      <div class="product-card-image-inner">
        <Image
          src={image}
          loading="lazy"
          width={600}
          height={400}
          alt={`${title} product photo`}
        />
      </div>
      {
        hasGuide && (
          <div
            class="product-card-guide"
            role="img"
            aria-label="Includes free user guide"
          >
            <FreeUserGuideIcon />
          </div>
        )
      }
    </div>
    <div class="product-card-body">
      <h3 class="product-card-title">{title}</h3>
      <p class="product-card-description">{description}</p>
    </div>
  </div>
</a>

<style>
  .product-card-link {
    display: block;
    transform: translate(0, 0);
    transition: transform 150ms ease-in;
  }
  .product-card-link:focus-visible {
    transform: translate(-2px, -5px);
  }
  .product-card-link:focus-visible .product-card-title {
    color: var(--color-surface-light-text-highlight);
  }
  .product-card-link:focus-visible .product-card {
    box-shadow:
      0 0 0 4px var(--color-neutral-600),
      var(--card-shadow-color-deep);
  }

  .product-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--color-surface-light);
    border-radius: var(--br-03) 3rem var(--br-03) var(--br-03);
    box-shadow: var(--card-shadow-neutral-medium);
    transition: box-shadow 200ms ease-in-out;
  }

  .product-card-image {
    position: relative;
    aspect-ratio: 4 / 3;
    height: auto;
    border-bottom: var(--border-surface-color-thick);
    /* no overflow: hidden here */
  }

  .product-card-image-inner {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: var(--br-03) 3rem 0 0;

    & img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
  }

  .product-card-body {
    flex: 1;
    padding-block-start: calc(var(--card-padding-block) - var(--sp-03));
    padding-block-end: var(--card-padding-block);
    padding-inline: var(--sp-05);
  }

  .product-card-title {
    font-size: var(--text-xl);
    margin-block-end: var(--sp-02);
    letter-spacing: var(--tracking-loose);
    text-wrap: balance;
    transition: color 200ms ease-in;
  }

  .product-card-description {
    line-height: var(--leading-normal);
    text-wrap: pretty;
  }

  .product-card-guide {
    position: absolute;
    bottom: 1.25rem;
    right: -1.125rem;
    transform: translateY(50%) rotate(5deg);
    filter: var(--art-shadow-neutral-medium);
  }

  @media (hover: hover) {
    .product-card-link:hover {
      transform: translate(-2px, -5px);
    }
    .product-card-link:hover .product-card-title {
      color: var(--color-surface-light-text-highlight);
    }
    .product-card-link:hover .product-card {
      box-shadow:
        0 0 0 4px var(--color-neutral-600),
        var(--card-shadow-color-deep);
    }
  }

  /* MOBILE */
  @media (max-width: 600px) {
    .product-card-link {
      scroll-snap-align: start;
    }
    .product-card-image {
      aspect-ratio: 4 / 3.5;
    }
    .product-card-title {
      letter-spacing: var(--tracking-tight);
    }
    .product-card-description {
      line-height: var(--leading-loose);
    }
    .product-card-body {
      /* padding-block-end: var(--sp-05); */
    }
  }
</style>
