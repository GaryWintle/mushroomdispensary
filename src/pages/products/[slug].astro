---
import Layout from "@layouts/Layout.astro";
export async function getStaticPaths() {
  return [{ params: { slug: "kratom" } }];
}
---

<Layout>
  <section class="section section--dark container--narrow test">
    <p class="product-breadcrumbs">home / products / kratom</p>
    <div class="product-grid">
      <div class="product-body-media"></div>
      <div class="product-body section--light">
        <div class="product-copy">
          <h1>Kratom</h1>
          <h2 class="product-tagline">
            Energy booster, mood lifter, pain reliever, and support for opioid
            withdrawal symptoms
          </h2>
          <p class="product-description">
            The powdered leaf of a tree native to Southeast Asia, kratom has
            opiate-like properties and is used for pain relief, sedation,
            relaxation, and euphoria. It comes in three main varieties: Red
            (sedating, pain-relieving), White (stimulating, energising), and
            Green (balanced between the two). Available in-store as powder and
            capsules.
          </p>
        </div>
        <blockquote class="product-warning">
          Regular use of kratom can cause dependence and withdrawal symptoms.
          Start low and use responsibly.
        </blockquote>
        <div class="product-button-container">
          <button class="product-button">Visit One of Our Stores</button>
          <button class="product-button">Free User Guide!</button>
          <p class="product-user-guide-helper-text">
            Full safety guide included with every in-store purchase
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .product-breadcrumbs {
    font-size: var(--text-sm);
    margin-bottom: var(--sp-fluid-01);
  }
  .product-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-gutter-primary);
  }
  .product-body-media {
    background-color: grey;
    width: 100%;
    aspect-ratio: 1;
    border-radius: var(--br-03);
  }
  .product-body {
    display: flex;
    flex-direction: column;
    gap: var(--sp-06);
    padding-block: calc(var(--body-padding-block) * 1.2);
    padding-inline: calc(var(--body-padding-inline) * 1.5);
    background-color: var(--color-surface-light);
    border-radius: var(--br-03);
  }
  .product-copy > * + * {
    /* margin-top: 0.6em; */
  }
  .product-tagline {
    margin-top: 0.3em;
    font-family: var(--font-body);
    font-size: var(--text-lg);
    font-variation-settings:
      "wdth" 100,
      "wght" 300;
    color: var(--color-surface-light-text-highlight);
    line-height: var(--leading-normal);
    font-style: italic;
    text-wrap: pretty;
    letter-spacing: var(--tracking-semiwide);
  }
  .product-description {
    margin-top: 1.2em;
    font-size: var(--text-base);
    font-variation-settings:
      "wdth" 100,
      "wght" 400;
    line-height: var(--leading-loose);
    text-wrap: pretty;
  }
  .product-warning {
    padding-inline: var(--sp-fluid-02);
    padding-block: var(--sp-fluid-01);
    background-color: var(--color-primary-100);
    font-variation-settings:
      "wdth" 95,
      "wght" 600;
    color: var(--color-primary-300);
    border: 2px solid var(--color-primary-300);
    border-radius: var(--br-02);
  }
  .product-button-container {
    display: flex;
    flex-direction: column;
    gap: var(--sp-02);
  }
  .product-button {
    padding-block: var(--button-block-sm);
    padding-inline: var(--button-inline-sm);
    background-color: var(--color-cta);
    color: var(--color-cta-text);
    border-radius: var(--br-03);
  }
  .product-user-guide-helper-text {
    align-self: center;
    font-size: var(--text-sm);
    font-variation-settings:
      "wdth" 95,
      "wght" 400;
    color: var(--color-surface-light-text-highlight);
    font-style: italic;
    text-align: center;
    text-wrap: pretty;
  }

  @media (max-width: 800px) {
    .product-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
