---
import CTAButton from "@components/ui/CTAButton.astro";
import SectionHeader from "@components/ui/SectionHeader.astro";
import ProductCard from "@components/ui/ProductCard.astro";
import MushyGuyHazy from "@images/mushyguyHazy.svg?raw";

import imgMushrooms from "@images/products/mushrooms.webp";
import imgCapsules from "@images/products/mushroom-capsules.jpg";
import imgKratom from "@images/products/kratom.jpg";
import imgCocaLeaf from "@images/products/coca-leaf.avif";
import imgPeyote from "@images/products/peyote.jpg";
import imgLSD from "@images/products/lsd.webp";
import imgDMT from "@images/products/dmt.jpg";
import imgBooks from "@images/products/books.jpg";

const products = [
  {
    id: 1,
    title: "Dried Mushrooms",
    description:
      "Classic and exotic dried strains, plus chocolates and gummies.",
    image: imgMushrooms,
    hasGuide: true,
    href: "",
  },
  {
    id: 2,
    title: "Mushroom Capsules",
    description:
      "Microdose capsules in precise strengths from 12.5mg to 500mg.",
    image: imgCapsules,
    hasGuide: true,
    href: "",
  },
  {
    id: 3,
    title: "Kratom",
    description:
      "Powder and capsule form, with a range of strains for energy, focus, and relaxation.",
    image: imgKratom,
    hasGuide: true,
    href: "",
  },
  {
    id: 4,
    title: "Coca Leaf",
    description: "Whole leaf for chewing or powdered for tea, stocks vary.",
    image: imgCocaLeaf,
    hasGuide: true,
    href: "",
  },
  {
    id: 5,
    title: "Peyote",
    description: "The sacred mescaline cactus, dried or as live plants.",
    image: imgPeyote,
    hasGuide: true,
    href: "",
  },
  {
    id: 6,
    title: "LSD",
    description: "Liquid and paper tabs, available in microdose and full-dose.",
    image: imgLSD,
    hasGuide: true,
    href: "",
  },
  {
    id: 7,
    title: "DMT",
    description: "Intense 15-minute experiences via vape pen or raw powder.",
    image: imgDMT,
    hasGuide: true,
    href: "",
  },
  {
    id: 8,
    title: "Books & Art",
    description: "Books, comics and art — all priced below Amazon.",
    image: imgBooks,
    hasGuide: false,
    href: "",
  },
];
---

<section class="section section--dark container">
  <div class="products">
    <SectionHeader
      title="Our Products"
      text="No other shop in the world carries the same range of products that we do!"
      sectionName="product"
    />
    <div class="products-grid">
      {
        products.map((product) => (
          <ProductCard
            title={product.title}
            description={product.description}
            image={product.image}
            hasGuide={product.hasGuide}
            href={product.href}
          />
        ))
      }
    </div>

    <div class="products-cta">
      <div class="products-cta-button">
        <CTAButton text="View Our Full Menu!" />
      </div>
      <div class="products-mushy-guy">
        <Fragment set:html={MushyGuyHazy} />
      </div>
    </div>
  </div>

  <style>
    .products-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(250px, 100%), 1fr));
      align-items: stretch;
      column-gap: var(--space-gutter-secondary);
      row-gap: var(--space-gutter-primary);
      margin-block-end: var(--space-sub-section-block);
    }
    .products-cta {
      position: relative;
      display: grid;
      place-content: center;
    }
    .products-mushy-guy {
      position: absolute;
      top: -120%;
      right: calc(50% - 20rem);
      z-index: 2;
      width: 8rem;
      pointer-events: none;
      rotate: 8deg;

      @media (prefers-reduced-motion: no-preference) {
        animation: bounce 2s ease-in-out infinite;
      }
    }

    @keyframes bounce {
      0%,
      100% {
        transform: translateY(0);
      }
      50% {
        transform: translateY(-3px);
      }
    }

    /* MOBILE */
    @media (max-width: 600px) {
      .products-grid {
        grid-template-columns: unset;
        grid-auto-flow: column;
        grid-auto-columns: 85%;
        overflow-x: scroll;
        scroll-snap-type: x mandatory;
        scrollbar-width: none;
        margin-inline: calc(-1 * var(--space-section-inline));
        padding-inline: var(--space-section-inline);
        margin-block-end: var(--sp-08);
        scroll-padding-inline: var(--space-section-inline);
        mask-image: linear-gradient(
          to right,
          transparent,
          black 5%,
          black 95%,
          transparent
        );
        -webkit-mask-image: linear-gradient(
          to right,
          transparent,
          black 5%,
          black 95%,
          transparent
        );
      }
      .products-cta-button {
        display: grid;
        text-align: center;
      }
      .products-mushy-guy {
        top: -120%;
        right: calc(50% - 15rem);
        width: 6rem;
      }
    }
  </style>

  <script>
    import gsap from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    gsap.registerPlugin(ScrollTrigger);

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: ".products",
        start: "top 80%",
      },
    });

    tl.from(".product-heading", {
      opacity: 0,
      y: 20,
      duration: 0.5,
      ease: "power2.out",
    }).from(
      ".products-grid .card-wrapper",
      {
        opacity: 0,
        duration: 1,
        ease: "power2.out",
        stagger: 0.1,
      },
      "+=0.1",
    );
  </script>
</section>
