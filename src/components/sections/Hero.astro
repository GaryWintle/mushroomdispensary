---
import Smiley from "@components/artwork/Smiley.astro";
import SeenOnTV from "@components/artwork/SeenOnTV.astro";
import CanadaFlag from "@components/artwork/CanadaFlag.astro";
---

<section class="section section--light hero">
  <div class="container">
    <div class="hero-grid">
      <div class="hero-card">
        <div class="icon-smiley">
          <Smiley />
        </div>
        <div class="icon-seen-on-tv">
          <SeenOnTV />
        </div>
        <h1 class="text-title-hero">
          Dedicated to&#8200;a&#8200;safe, psychedelic supply
        </h1>
        <p class="text-body-display hero-text-body">
          We believe in the benefits of psychedelics and want to challenge
          <span class="inline-icon">
            <CanadaFlag />
          </span>
          's failed drug prohibition laws.
        </p>
      </div>
      <div class="hero-video">
        <div class="video-wrapper">
          <!-- To re-enable autoplay, add autoplay=1& before mute=1 in the src -->
          <div class="video-overlay"></div>
          <iframe
            src="https://www.youtube-nocookie.com/embed/0rFVeZ9mpe0?autoplay=1&mute=1&loop=1&playlist=0rFVeZ9mpe0&controls=0&modestbranding=1&rel=0"
            title="Hero video"
            loading="eager"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen></iframe>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    container-type: inline-size;
    container-name: hero;
    padding-block-start: var(--sp-07);
    padding-block-end: var(--sp-05);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 2fr;
    align-items: start;
    gap: var(--sp-04);
  }

  .hero-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--sp-04);
    background-color: var(--color-surface-light);
    border-radius: var(--br-03);
    padding-block: var(--sp-07);
    padding-inline: var(--sp-06);
    box-shadow: var(--card-shadow-neutral-deep);
    align-self: stretch;
  }

  .hero-text-body {
    width: var(--measure-narrow);
  }

  .hero-video {
    border-radius: var(--br-03);
    overflow: hidden;
    box-shadow: var(--card-shadow-neutral-deep);
    aspect-ratio: 16 / 9;
  }

  .video-wrapper {
    position: relative;
    aspect-ratio: 16 / 9;
  }
  .video-wrapper::after {
    content: "";
    position: absolute;
    inset: 10px;
    box-shadow: inset 0 0 0 2px oklch(from var(--color-primary-200) l c h / 0.8);
    z-index: 1;
    pointer-events: none;
    border-radius: var(--br-02);
  }
  .video-wrapper::before {
    content: "";
    position: absolute;
    inset: 0;
    box-shadow: inset 0 0 35px 5px var(--color-neutral-600-50);
    z-index: 1;
    pointer-events: none;
  }

  .video-wrapper iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .video-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    cursor: default;
  }

  .video-wrapper:hover .video-overlay {
    pointer-events: none;
  }

  .inline-icon {
    display: inline-flex;
    align-items: center;
    vertical-align: middle;
  }

  .inline-icon svg {
    width: 1em;
    height: auto;
  }
  .icon-seen-on-tv {
    position: absolute;
    right: 0;
    bottom: 0;
    transform: translate(35%, -20%) rotate(-5deg);
    z-index: 2;
  }

  .icon-seen-on-tv :global(svg) {
    width: 9rem;
    height: 9rem;
    filter: var(--art-shadow-neutral-medium);
  }

  .icon-smiley {
    position: absolute;
    top: 0;
    right: 0;
    transform: translate(-17%, 45%) rotate(16deg);
    filter: var(--art-shadow-color-shallow);
  }

  .icon-smiley :global(svg) {
    width: 4.5rem;
    height: 4.5rem;
  }

  @container hero (max-width: 1177px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .hero-video {
      order: -1;
    }
    .hero-card {
      flex-direction: row;
      border-top: var(--border-photo-dark-thin);
      border-radius: 0 0 var(--br-03) var(--br-03);
      align-items: start;
      padding-block-start: var(--sp-06);
      padding-block-end: var(--sp-07);
    }
    .hero-text-body {
      text-box: trim-both cap alphabetic;
      width: 80%;
    }
    .hero-video {
      border-radius: var(--br-03);
      overflow: hidden;
      border-radius: var(--br-03) var(--br-03) 0 0;
      box-shadow: var(--card-shadow-neutral-deep);
      aspect-ratio: 16 / 9;
    }
    .icon-seen-on-tv {
      position: absolute;
      right: 0;
      bottom: 0;
      transform: translate(20%, -160%) rotate(35deg);
      z-index: 2;
    }

    .icon-seen-on-tv :global(svg) {
      width: 9rem;
      height: 9rem;
      filter: var(--art-shadow-neutral-medium);
    }
    .icon-smiley {
      transform: translate(20%, 155%) rotate(16deg);
    }

    .icon-smiley :global(svg) {
      width: 4rem;
      height: 4rem;
    }
  }
  @container hero (max-width: 850px) {
    .hero-card {
      flex-direction: column;
      border-top: var(--border-photo-dark-thin);
      border-radius: 0 0 var(--br-03) var(--br-03);
      align-items: start;
      padding-block-start: var(--sp-06);
      padding-block-end: var(--sp-07);
    }
    .icon-seen-on-tv {
      transform: translate(20%, -60%) rotate(35deg);
      z-index: 2;
    }

    .icon-seen-on-tv :global(svg) {
      width: 9rem;
      height: 9rem;
    }
    .icon-smiley {
      transform: translate(-150%, 155%) rotate(16deg);
    }

    .icon-smiley :global(svg) {
      width: 4.5rem;
      height: 4.5rem;
    }
  }
</style>
