---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  cityArea: string;
  address: string;
  storeHours: { days: string; hours: string }[];
  image: ImageMetadata;
  locationIcon: string;
  href: string;
}

const {
  cityArea = "City Area",
  address = "420 Hastings St.",
  storeHours = [],
  image,
  locationIcon,
  href = "/",
} = Astro.props;
---

<div class="location-card">
  <a
    href={href}
    class="location-card-image"
    target="_blank"
    rel="noopener noreferrer"
    aria-label={`View ${cityArea} on map (opens in new tab)`}
  >
    <Image
      src={image}
      loading="lazy"
      width={1042}
      height={693}
      alt={`Map showing ${cityArea} store at ${address}`}
    />
  </a>
  <div class="location-card-body">
    <div
      set:html={locationIcon}
      class="location-card-icon"
      aria-hidden="true"
    />
    <h3 class="location-card-title">{cityArea}</h3>
    <address class="location-card-address">{address}</address>

    <dl class="location-card-hours">
      {
        storeHours.map((s) => (
          <>
            <dt class="location-card-schedule">{s.days}</dt>
            <dd class="location-card-time">{s.hours}</dd>
          </>
        ))
      }
    </dl>
  </div>
</div>

<style>
  /* DESKTOP */

  .location-card {
    display: flex;
    overflow: hidden; /* clips image corners to card border-radius */
    border: var(--border-photo-dark-thin);
    border-radius: var(--br-03);
    box-shadow: var(--card-shadow-neutral-deep);
  }
  .location-card-image {
    flex: 4 1 0; /* takes 2/3 of card width here*/
    overflow: hidden;
    border-right: var(--border-surface-color-thick);
    & img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      @media (prefers-reduced-motion: no-preference) {
        transition: scale 0.4s ease;
        &:hover {
          scale: 1.25;
        }
      }
    }
    &:focus-visible {
      outline: var(--keyboard-focus);
      outline-offset: 3px;
    }
  }
  .location-card-body {
    position: relative; /* for icon positioning */
    display: flex;
    flex: 2 0 0; /* takes 1/3 of card width */
    flex-direction: column;
    justify-content: center;
    padding-inline: var(--sp-08) var(--sp-07);
    padding-block: var(--sp-05);
    background-color: var(--color-surface-light);
    color: var(--color-surface-light-text);
  }
  .location-card-icon {
    position: absolute;
    /* Custom positioning for the address # badge */
    top: 15%;
    left: -10%;
    width: 4rem;
    filter: var(--art-shadow-neutral-medium);
  }
  .location-card-title {
    margin-block-end: var(--sp-04);
    font-size: var(--text-2xl);
    text-box: trim-both cap alphabetic;
    text-transform: uppercase;
    color: var(--color-surface-light-text-highlight);
  }
  .location-card-address {
    margin-block-end: var(--sp-06);
    font-family: var(--font-body);
    font-size: var(--text-xl);
    font-variation-settings: var(--fvs-tight-heavy);
    text-box: trim-both cap alphabetic;
    letter-spacing: var(--tracking-tight);
  }
  .location-card-hours {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0 var(--sp-03);
    align-items: baseline;
    font-size: var(--text-lg);
    line-height: var(--leading-loose);
  }
  .location-card-schedule {
    font-variation-settings: var(--fvs-tight-bold);
  }

  .location-card-time {
    color: var(--color-surface-light-text-highlight);
    font-variation-settings: var(--fvs-tight-heavy);
  }

  /* TABLET */
  @media (max-width: 900px) {
    .location-card-body {
      flex: 3 0 0;
      padding-inline: var(--sp-07) var(--sp-07);
      padding-block: var(--sp-07);
    }
  }

  /* MOBILE */
  @media (max-width: 650px) {
    .location-card {
      flex-direction: column;
      overflow: unset;
      flex: 0 0 85%;
      scroll-snap-align: start;
    }

    .location-card-image {
      flex: 2 1 100%;
      height: auto;
      aspect-ratio: 3 / 2;
      border-radius: var(--br-03) var(--br-03) 0 0;
      border-right: unset;
      border-bottom: var(--border-surface-color-thick);
      & img {
        scale: 1.3;
        translate: 15%; /* pans map view toward dispensary pin */
      }
    }
    .location-card-body {
      align-items: center;
      padding-block: var(--sp-06) var(--sp-09);
      padding-inline: var(--sp-06);
      border-radius: 0 0 var(--br-03) var(--br-03);
    }
    .location-card-title {
      text-align: center;
    }
    .location-card-icon {
      width: 4.5rem;
      top: -15%;
      right: auto;
      left: -4%;
    }
    .location-card-hours {
      row-gap: var(--sp-01);
    }
  }
</style>
