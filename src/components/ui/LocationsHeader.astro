---
import PhoneIllo from "@components/artwork/PhoneIllo.astro";
import AdultsOnly from "./AdultsOnly.astro";
---

<section class="locations-header">
  <div class="locations-header-phone-contact-body">
    <div class="locations-header-illustration-container">
      <PhoneIllo />
    </div>

    <div
      class="locations-header-phone-text-container"
      role="group"
      aria-label="Contact phone number"
    >
      <p class="locations-header-phone-contact-text">
        Same phone number for all locations:
      </p>
      <a
        href="tel:+16043434687"
        aria-label="Call 604-343-4687"
        class="subtitle location-header-phonenumber">604-343-4687</a
      >
    </div>
  </div>
  <div class="locations-header-container-adults-only">
    <AdultsOnly />
  </div>
</section>

<style>
  .locations-header {
    position: relative;
    grid-area: sidebar;
    display: flex;
    flex-direction: column;
    gap: var(--space-sub-section-block);
  }
  .locations-header-phone-contact-body {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-sub-section-block);
    padding-block: var(--body-padding-block);
    padding-inline: var(--body-padding-inline);
    border: var(--border-surface-dark-thinnest);
    border-radius: var(--br-03);
    background-color: var(--color-neutral-600-50);
  }
  .locations-header-illustration-container {
    display: grid;
    place-items: center;
    & :global(svg) {
      width: 80%;
      height: auto;
    }
  }

  .locations-header-phone-contact-text {
    text-align: center;
    margin-block-end: var(--space-after-body-text);
  }
  .location-header-phonenumber {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, calc(2vw + 1rem), 3rem);
    text-transform: uppercase;
    text-align: center;
  }

  @media (max-width: 1135px) {
    .locations-header {
      gap: 0;
    }
    .location-header-phonenumber {
      font-size: clamp(2.3rem, calc(5vw + 1rem), 4rem);
    }
    .locations-header-container-adults-only {
      display: none;
    }
  }
  @media (max-width: 600px) {
    .locations-header {
    }
  }
</style>
