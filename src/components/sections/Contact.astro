---
import { Image } from "astro:assets";

// import location1 from "@images/locations/mushdisp-location-01.webp";
import location1 from "@images/locations/Map01-davie.png";
import location2 from "@images/locations/Map02-eastvancouver.png";
import location3 from "@images/locations/Map03-mountpleasant.png";
import PhoneIllo from "@components/artwork/PhoneIllo.astro";
import LocationIcon01 from "@images/location1.svg?raw";
import LocationIcon02 from "@images/location2.svg?raw";
import LocationIcon03 from "@images/location3.svg?raw";

import NineteenPlus from "@components/artwork/NineteenPlus.astro";

import LocationCard from "@components/ui/LocationCard.astro";

const locations = [
  {
    cityArea: "West End Vancouver",
    address: "1674 Davie St.",
    storeHours: [
      { days: "Mon-Wed", hours: "11am-7pm" },
      { days: "Thu-Sat", hours: "10am-11pm" },
      { days: "Sun", hours: "11am-6pm" },
    ],
    image: location1,
    locationIcon: LocationIcon01,
    href: "https://maps.app.goo.gl/ZWsd2aXFoNPHkgMFA",
  },
  {
    cityArea: "East Vancouver",
    address: "651 East Hastings",
    storeHours: [
      { days: "Mon-Thu", hours: "10am-10pm" },
      { days: "Fri-Sat", hours: "10am-11pm" },
      { days: "Sun", hours: "11am-6pm" },
    ],
    image: location2,
    locationIcon: LocationIcon02,
    href: "https://maps.app.goo.gl/fSV8WLYfYqDHX6oY8",
  },
  {
    cityArea: "Mount Pleasant",
    address: "247 West Broadway",
    storeHours: [
      { days: "Mon-Wed", hours: "11am-7pm" },
      { days: "Thu-Sat", hours: "10am-10pm" },
      { days: "Sun", hours: "11am-6pm" },
    ],
    image: location3,
    locationIcon: LocationIcon03,
    href: "https://maps.app.goo.gl/obv896WAwTtwXzNX7",
  },
];
---

<section class="section section--dark contact">
  <div class="container">
    <div class="contact-container">
      <div class="locations-header-container">
        <div class="locations-header">
          <div class="header-text-container">
            <h2 class="subtitle --bignumber --margin-bottom">3</h2>
            <h2 class="subtitle --locations --margin-bottom">Locations!</h2>
            <p class="text-body-display">
              We have three storefronts in Vancouver, BC, Canada
            </p>
          </div>
          <div class="illo-container">
            <PhoneIllo />
          </div>
          <div class="bottom-text-container">
            <p class="text-body-display --margin-bottom-large">
              Same phone number <br />for all locations:
            </p>
            <a href="tel:+16043434687" class="subtitle --phonenumber"
              >604-343-4687</a
            >
          </div>
        </div>
        <div class="container-adultsonly">
          <h2 class="subtitle --adultsonly --margin-bottom">Adults Only</h2>
          <p class="text-body-display">
            Minors <span class="--underline">cannot enter </span> unless accompanied
            by a parent. Minors cannot make any purchases.
          </p>
          <div class="art-container">
            <NineteenPlus />
          </div>
        </div>
      </div>

      <div class="locations-card">
        {
          locations.map((location) => (
            <LocationCard
              cityArea={location.cityArea}
              address={location.address}
              storeHours={location.storeHours}
              image={location.image}
              locationIcon={location.locationIcon}
              href={location.href}
            />
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const tl = gsap.timeline({
    scrollTrigger: {
      trigger: ".contact",
      start: "top 80%",
    },
  });

  tl.from(".locations-header-container", {
    opacity: 0,
    y: 20,
    duration: 0.5,
    ease: "power2.out",
  }).from(
    ".locations-card .location",
    {
      opacity: 0,
      duration: 1,
      ease: "power2.out",
      stagger: 0.25,
    },
    "+=0.1",
  );
</script>

<style>
  section {
    overflow: clip;
  }

  .contact-container {
    display: grid;
    grid-template-columns: 1fr 2fr;
    grid-template-areas: "sidebar cards";
    gap: var(--sp-05);
  }
  .locations-header {
    grid-area: sidebar;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-07);
    padding-inline: var(--sp-05);
    padding-block: var(--sp-05);
  }
  .locations-card {
    grid-area: cards;
    display: flex;
    flex-direction: column;
    gap: var(--sp-04);
  }
  .locations-header {
    border: var(--border-surface-dark-thin);
    border-radius: var(--br-03);
    background-color: var(--color-neutral-600-50);

    position: relative;
    padding-block-start: var(--sp-09);
    padding-block-end: var(--sp-08);
    text-align: center;
  }
  .--bignumber {
    font-size: 10rem;
    position: absolute;
    top: -25px;
    left: 50%;
    transform: translateX(-50%);
    text-box: trim-both cap alphabetic;
  }
  .--locations {
    margin-top: 0.2em;
    font-size: clamp(2rem, calc(5vw + 1rem), 3rem);
    text-transform: uppercase;
  }
  .--phonenumber {
    font-family: var(--font-display);
    font-size: clamp(2rem, calc(5vw + 1rem), 3rem);
    text-transform: uppercase;
  }

  .container-adultsonly {
    padding-block: var(--sp-08);
    padding-inline: var(--sp-07);
    position: relative;
  }

  .--adultsonly {
    text-align: start;
  }
  .art-container {
    position: absolute;
    top: 22px;
    right: 24px;
  }

  @media (max-width: 1135px) {
    .contact-container {
      grid-template-columns: 1fr;
      grid-template-areas:
        "sidebar"
        "cards";
      gap: var(--sp-05);
    }
  }
</style>
