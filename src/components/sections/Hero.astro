---
import Smiley from "@components/artwork/Smiley.astro";
import SeenOnTV from "@components/artwork/SeenOnTV.astro";
import CanadaFlag from "@components/artwork/CanadaFlag.astro";
import CTAButton from "@components/ui/CTAButton.astro";

import danaCounter from "@images/carousel/mushdisp-dana-counter.webp";
import products from "@images/carousel/mushdisp-products.webp";
import storefront from "@images/carousel/mushdisp-storefront.jpg";
import mushcounter from "@images/carousel/mushdisp-mushcounter.jpg";
import mushwithlabels from "@images/carousel/mushdisp-mushwithlabels.avif";
import signage from "@images/carousel/mushdisp-signage.jpg";

const images = [
  {
    src: danaCounter,
    alt: "Store front on Main Street",
    caption: "Founder Dana Larsen working the desk",
  },
  {
    src: mushcounter,
    alt: "Interior mushroom display",
    caption: "A beautiful collection of just some of our products",
  },
  {
    src: signage,
    alt: "Interior mushroom display",
    caption: "Please stop by for a visit!",
  },
  {
    src: products,
    alt: "Interior mushroom display",
    caption: "A beautiful collection of just some of our products",
  },
  {
    src: storefront,
    alt: "Interior mushroom display",
    caption: "Please stop by for a visit!",
  },
  {
    src: mushwithlabels,
    alt: "Interior mushroom display",
    caption: "Please stop by for a visit!",
  },
];
---

<section class="section section--light hero">
  <div class="container">
    <div class="hero-grid">
      <!-- <div class="carousel-container"><PhotoCarousel images={images} /></div> -->
      <div class="hero-card">
        <div class="icon-smiley">
          <Smiley />
        </div>
        <h1 class="text-title-hero">
          Dedicated to&#8200;a&#8200;safe, psychedelic supply
        </h1>

        <p class="hero-text-body">
          We believe in the benefits of psychedelics and want to challenge
          <span class="inline-icon">
            <CanadaFlag />
          </span>
          's failed drug prohibition laws.
        </p>
        <div class="news-cta-button">
          <CTAButton text="Our Story" onLight />
        </div>
      </div>
      <div class="hero-video --desktop-only">
        <div class="video-wrapper">
          <div class="icon-seen-on-tv">
            <SeenOnTV />
          </div>
          <!-- To re-enable autoplay, add autoplay=1& before mute=1 in the src -->
          <div class="video-overlay"></div>
          <iframe
            src="https://www.youtube-nocookie.com/embed/0rFVeZ9mpe0?autoplay=1&mute=1&loop=1&playlist=0rFVeZ9mpe0&controls=0&modestbranding=1&rel=0"
            title="Hero video"
            loading="eager"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen></iframe>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    container-type: inline-size;
    container-name: hero;
    padding-block-start: var(--sp-07);
    padding-block-end: var(--sp-05);
    overflow: clip;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 2fr;
    align-items: start;
    gap: var(--sp-04);
  }

  .hero-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--sp-04);
    background-color: var(--color-surface-light);
    border-radius: var(--br-03);
    padding-block: var(--sp-07);
    padding-inline: var(--sp-06);
    box-shadow: var(--card-shadow-neutral-deep);
    align-self: stretch;
  }

  .hero-text-body {
    width: var(--measure-narrow);
  }
  .hero-text-textandbutton-container {
    gap: var(--sp-04);
  }

  .hero-video {
    border-radius: var(--br-03);
    /* overflow: hidden; */
    box-shadow: var(--card-shadow-neutral-deep);
    aspect-ratio: 16 / 9;
  }

  .video-wrapper {
    position: relative;
    aspect-ratio: 16 / 9;
  }
  .video-wrapper::after {
    content: "";
    position: absolute;
    inset: 10px;
    box-shadow: inset 0 0 0 2px oklch(from var(--color-primary-200) l c h / 0.8);
    z-index: 1;
    pointer-events: none;
    border-radius: var(--br-02);
  }
  .video-wrapper::before {
    content: "";
    position: absolute;
    inset: 0;
    box-shadow: inset 0 0 35px 5px var(--color-neutral-600-50);
    z-index: 1;
    pointer-events: none;
  }

  .video-wrapper iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    border-radius: var(--br-03);
  }

  .video-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    cursor: default;
  }

  .video-wrapper:hover .video-overlay {
    pointer-events: none;
  }

  .inline-icon {
    display: inline-flex;
    align-items: center;
    vertical-align: middle;
  }

  .inline-icon svg {
    width: 1em;
    height: auto;
  }
  .icon-seen-on-tv {
    position: absolute;
    right: 0;
    bottom: 0;
    transform: translate(35%, -20%) rotate(35deg);
    z-index: 2;
  }

  .icon-seen-on-tv :global(svg) {
    width: 9rem;
    height: 9rem;
    filter: var(--art-shadow-neutral-medium);
  }

  .icon-smiley {
    position: absolute;
    top: 0;
    right: 0;
    transform: translate(-17%, 45%) rotate(16deg);
    filter: var(--art-shadow-color-shallow);
  }

  .icon-smiley :global(svg) {
    width: 4.5rem;
    height: 4.5rem;
  }

  @container hero (max-width: 1177px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .hero-video {
      order: -1;
    }
    .hero-card {
      flex-direction: row;
      border-top: var(--border-photo-dark-thin);
      border-radius: 0 0 var(--br-03) var(--br-03);
      align-items: start;
      padding-block-start: var(--sp-06);
      padding-block-end: var(--sp-07);
    }
    .hero-text-body {
      text-box: trim-both cap alphabetic;
      width: 100%;
    }
    .hero-video {
      border-radius: var(--br-03);
      /* overflow: hidden; */
      border-radius: var(--br-03) var(--br-03) 0 0;
      box-shadow: var(--card-shadow-neutral-deep);
      aspect-ratio: 16 / 9;
    }
    .icon-seen-on-tv {
      position: absolute;
      right: 0;
      bottom: 0;
      transform: translate(20%, -160%) rotate(35deg);
      z-index: 2;
    }

    .icon-seen-on-tv :global(svg) {
      width: 9rem;
      height: 9rem;
      filter: var(--art-shadow-neutral-medium);
    }
    .icon-smiley {
      transform: translate(20%, 155%) rotate(16deg);
    }

    .icon-smiley :global(svg) {
      width: 4rem;
      height: 4rem;
    }
  }
  @media (max-width: 850px) {
    .hero {
      overflow: visible;
    }
  }

  @container hero (max-width: 850px) {
    .hero-card {
      flex-direction: column;
      border: var(--border-photo-dark-thin);
      border-radius: var(--br-03);
      align-items: start;
      padding-block-start: var(--sp-06);
      padding-block-end: var(--sp-07);
      margin-top: -80px;
      z-index: 999;
    }
    .icon-seen-on-tv {
      transform: translate(20%, -60%) rotate(35deg);
      z-index: 2;
      display: none;
    }

    .icon-seen-on-tv :global(svg) {
      width: 9rem;
      height: 9rem;
    }
    .icon-smiley {
      transform: translate(-20%, -25%) rotate(16deg);
    }

    .icon-smiley :global(svg) {
      width: 4rem;
      height: 4rem;
    }
    .--desktop-only {
      display: none;
    }
    .text-title-hero {
      font-size: var(--text-hero);
      text-transform: uppercase;
      text-wrap: balance;
      text-box: trim-both cap alphabetic;
      line-height: 1.05;
    }

    .text-body-display {
      font-size: var(--text-lg);
      line-height: var(--leading-loose);
      font-variation-settings:
        "wdth" 100,
        "wght" 600;
      text-wrap: unset;
    }
  }
</style>
