---
import Layout from "@layouts/Layout.astro";

import Hero from "@components/sections/Hero.astro";
import Testimonials from "@components/sections/Testimonials.astro";
import LogoMarquee from "@components/sections/LogoMarquee.astro";
import InTheNews from "@components/sections/InTheNews.astro";
import Products from "@components/sections/Products.astro";
import PhotoCarousel from "@components/sections/PhotoCarousel.astro";
import Contact from "@components/sections/Contact.astro";
import ScrollPinTester from "@components/sections/ScrollPinTester.astro";

import { images, imagesMobile } from "@data/images";
---

<Layout>
  <div class="carousel-container mobile-only">
    <PhotoCarousel images={imagesMobile} mobileHero={true} />
  </div>
  <Hero />
  <Testimonials />
  <div class="mobile-only"><LogoMarquee /></div>
  <div class="desktop-only"><InTheNews /></div>
  <!-- <ScrollPinTester /> -->

  <Products />
  <div class="desktop-only"><PhotoCarousel images={images} /></div>
  <Contact />
</Layout>

<style>
  .mobile-only {
    display: none;
  }
  @media (max-width: 850px) {
    .mobile-only {
      display: block;
    }
    .desktop-only {
      display: none;
    }
  }
</style>
