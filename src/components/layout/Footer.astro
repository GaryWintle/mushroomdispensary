---
import LogoRectangular from "@components/artwork/LogoRectangular.astro";
---

<footer class="footer-wrapper section--colored">
  <div class="container">
    <nav class="nav-flex">
      <div class="logo-container">
        <LogoRectangular />
      </div>
      <div class="footer-text-container">
        <ul class="nav-links-flex">
          <li>Our Story</li>
          <li>In The News</li>
          <li>Hours & Contact</li>
          <li>Full Menu</li>
        </ul>
        <p class="copyright-text">
          © Medicinal Mushroom Dispensary 2025. All rights reserved.
        </p>
      </div>
    </nav>
  </div>
</footer>

<style>
  .footer-wrapper {
    width: 100%;
    padding-block: var(--sp-04);
    background-color: var(--color-secondary-200);
  }
  .container {
    /* position: relative; */
  }
  .logo-container {
    width: min(100%, 12rem);
  }
  .logo-container svg {
    width: 100%;
    height: auto;
  }
  .nav-flex {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .nav-links-flex {
    display: flex;
    color: var(--color-nav-text);
    /* gap: var(--sp-02); */
  }

  .nav-links-flex > li {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-semiwide);
    padding-inline: var(--sp-04);
    padding-block: var(--sp-05-5);
    text-shadow: var(--text-shadow-color);
    transition:
      color 200ms ease,
      background-color 200ms ease;
  }

  .nav-links-flex > li:hover {
    text-shadow: none;
    cursor: pointer;
  }
  .copyright-text {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    text-align: end;
    margin-inline-end: var(--sp-03);
  }
</style>
