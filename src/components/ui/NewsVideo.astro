---
import type { NewsVideoItem } from "@data/news";

type Props = NewsVideoItem;

const { youtubeId = "", title = "", source = "", date = "" } = Astro.props;

const id = youtubeId.trim();
const hasVideo = id.length > 0;
// hqdefault is always available for any public video.
const thumb = hasVideo ? `https://i.ytimg.com/vi/${id}/hqdefault.jpg` : "";
const hasMeta = Boolean(source || title || date);
---

<li class:list={["news-video", { "news-video--empty": !hasVideo }]}>
  <div class="news-video-frame">
    {
      hasVideo ? (
        <button
          type="button"
          class="news-video-trigger"
          data-youtube-id={id}
          aria-label={title ? `Play video: ${title}` : "Play video"}
        >
          <img
            class="news-video-thumb"
            src={thumb}
            alt=""
            loading="lazy"
            width="480"
            height="360"
          />
          <span class="news-video-play" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="currentColor" width="28" height="28">
              <path d="M8 5v14l11-7z" />
            </svg>
          </span>
        </button>
      ) : (
        <div class="news-video-placeholder">
          <span
            class="news-video-play news-video-play--static"
            aria-hidden="true"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" width="28" height="28">
              <path d="M8 5v14l11-7z" />
            </svg>
          </span>
          <span class="news-video-placeholder-text">Video coming soon</span>
        </div>
      )
    }
  </div>

  {
    hasMeta && (
      <div class="news-video-meta">
        {(source || date) && (
          <div class="news-video-top">
            {source && <span class="news-video-source">{source}</span>}
            {date && <span class="news-video-date">{date}</span>}
          </div>
        )}
        {title && <h3 class="news-video-title">{title}</h3>}
      </div>
    )
  }
</li>

<style>
  .news-video {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--color-surface-light);
    border-radius: var(--br-03);
    box-shadow: var(--card-shadow-neutral-medium);
    overflow: hidden;
    transition: box-shadow 200ms ease-in-out;
  }

  .news-video-frame {
    position: relative;
    aspect-ratio: 16 / 9;
    border-block-end: var(--border-surface-color-thick);
    background: var(--color-neutral-600);
  }

  /* Facade button + thumbnail */
  .news-video-trigger {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 0;
    cursor: pointer;
    background: var(--color-neutral-600);
  }
  .news-video-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 250ms ease;
  }

  .news-video-play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    padding-inline-start: 0.2rem;
    border-radius: 50%;
    background: oklch(from var(--color-neutral-600) l c h / 0.7);
    color: var(--color-neutral-100);
    transition:
      transform 200ms ease,
      background 200ms ease;
  }

  /* The iframe injected on click */
  .news-video-frame :global(.news-video-iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .news-video-meta {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--sp-02);
    padding-block: var(--sp-04) var(--card-padding-block);
    padding-inline: var(--sp-05);
    color: var(--color-surface-light-text);
  }
  .news-video-top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-02) var(--sp-04);
  }
  .news-video-source {
    font-family: var(--font-display);
    font-size: var(--text-base);
    letter-spacing: var(--tracking-tight);
    color: var(--color-surface-light-text-highlight);
  }
  .news-video-date {
    font-size: var(--text-xsm);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-neutral-500);
    white-space: nowrap;
  }
  .news-video-title {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-variation-settings: var(--fvs-tight-bold);
    line-height: var(--leading-normal);
    letter-spacing: normal;
    text-wrap: pretty;
  }

  @media (hover: hover) {
    /* .news-video:has(.news-video-trigger):hover {
      box-shadow:
        0 0 0 4px var(--color-neutral-600),
        var(--card-shadow-color-deep);
    } */
    .news-video-trigger:hover .news-video-thumb {
      transform: scale(1.04);
    }
    /* .news-video-trigger:hover .news-video-play {
      transform: translate(-50%, -50%) scale(1.08);
      background: oklch(from var(--color-neutral-600) l c h / 0.9);
    } */
  }
  .news-video-trigger:focus-visible {
    outline: var(--keyboard-focus);
    outline-offset: -4px;
  }
  .news-video-trigger:focus-visible .news-video-play {
    transform: translate(-50%, -50%) scale(1.08);
  }

  @media (prefers-reduced-motion: reduce) {
    .news-video,
    .news-video-thumb,
    .news-video-play {
      transition: none;
    }
  }
</style>

<script>
  // Click-to-load facade: swap the thumbnail button for the real iframe only
  // when the user actually wants to watch — keeps the page light and private.
  document
    .querySelectorAll<HTMLButtonElement>(".news-video-trigger")
    .forEach((btn) => {
      btn.addEventListener("click", () => {
        const id = btn.dataset.youtubeId;
        if (!id) return;

        const iframe = document.createElement("iframe");
        iframe.className = "news-video-iframe";
        iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
        iframe.title = btn.getAttribute("aria-label") ?? "YouTube video";
        iframe.allow =
          "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
        iframe.allowFullscreen = true;

        btn.replaceWith(iframe);
      });
    });
</script>
