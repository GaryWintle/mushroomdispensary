---
import SectionHeader from "@components/ui/SectionHeader.astro";
import LocationsHeader from "@components/ui/LocationsHeader.astro";
import LocationCard from "@components/ui/LocationCard.astro";
import AdultsOnly from "@components/ui/AdultsOnly.astro";

import { locations } from "@data/locations";
---

<section
  id="contact-section"
  class="section section--dark container contact"
  data-animation="contact-wrapper"
>
  <SectionHeader
    title="3 Locations!"
    text="We have three safe, psychedlic storefronts in Vancouver, BC, Canada"
    sectionName="contact"
  />
  <div class="contact-container">
    <LocationsHeader />
    <div class="locations-card">
      {
        locations.map((location) => (
          <LocationCard
            cityArea={location.cityArea}
            address={location.address}
            storeHours={location.storeHours}
            image={location.image}
            locationIcon={location.locationIcon}
            href={location.href}
          />
        ))
      }
    </div>
    <div class="contact-container-adults-only">
      <AdultsOnly />
    </div>
  </div>
</section>

<style>
  .contact-container {
    display: grid;
    grid-template-columns: 1fr 2fr;
    grid-template-areas: "sidebar cards";
    gap: var(--space-gutter-primary);
  }
  .locations-card {
    grid-area: cards;
    display: flex;
    flex-direction: column;
    gap: var(--space-gutter-secondary);
  }
  .contact-container-adults-only {
    display: none;
  }

  @media (max-width: 1135px) {
    .contact-container {
      grid-template-columns: 1fr;
      grid-template-areas:
        "sidebar"
        "cards";
      gap: var(--space-gutter-secondary);
    }
    .contact-container-adults-only {
      display: revert;
    }
  }

  @media (max-width: 650px) {
    .locations-card {
      flex-direction: row;
      overflow-x: scroll;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      margin-inline: calc(-1 * var(--space-section-inline));
      padding-inline: var(--space-section-inline);
      scroll-padding-inline: var(--space-section-inline);
      mask-image: linear-gradient(
        to right,
        transparent,
        black 7%,
        black 93%,
        transparent
      );
      -webkit-mask-image: linear-gradient(
        to right,
        transparent,
        black 7%,
        black 93%,
        transparent
      );
    }
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const contactWrapper = document.querySelector(
    '[data-animation="contact-wrapper"]',
  );
  const sectionHeader = document.querySelector(
    '[data-animate="contact-header"]',
  );
  const locationsHeader = document.querySelector(
    '[data-animation="contact-locations-header"]',
  );
  const locationCards = document.querySelectorAll(
    '[data-animation="location-card"]',
  );

  const tl = gsap.timeline({
    scrollTrigger: {
      trigger: contactWrapper,
      start: "top 80%",
    },
  });

  tl.from(sectionHeader, {
    opacity: 0,
    y: 20,
    duration: 0.5,
    ease: "power2.out",
  })
    .from(locationsHeader, {
      opacity: 0,
      y: 20,
      duration: 0.5,
      ease: "power2.out",
    })
    .from(
      locationCards,
      {
        opacity: 0,
        duration: 1,
        ease: "power2.out",
        stagger: 0.25,
      },
      "+=0.1",
    );
</script>
