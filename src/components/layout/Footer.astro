---
import LogoRectangular from "@components/artwork/LogoRectangular.astro";
---

<footer class="footer-wrapper section--colored">
  <div class="footer-body container">
    <a
      href="/"
      class="footer-logo"
      aria-label="Medicinal Mushroom Dispensary - home"
    >
      <LogoRectangular />
    </a>
    <div class="footer-content">
      <nav class="footer-navigation" aria-label="Footer navigation">
        <ul class="footer-links" role="list">
          <li><a href="">Our Story</a></li>
          <li><a href="">News</a></li>
          <li><a href="">Contact</a></li>
          <li><a href="">Menu</a></li>
        </ul>
      </nav>
      <small class="footer-copyright">
        © Medicinal Mushroom Dispensary <span id="footer-year">2026</span>. All
        rights reserved.
      </small>
    </div>
  </div>
</footer>

<style>
  .footer-wrapper {
    width: 100%;
    padding-block: var(--sp-04);
    background-color: var(--color-secondary-200);
  }
  .footer-logo {
    width: min(100%, 12rem);
    padding-block-end: var(--sp-04);
    svg {
      width: 100%;
      height: auto;
    }
  }
  .footer-body {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .footer-navigation {
    margin-block-end: var(--sp-04);
  }

  .footer-links {
    display: flex;
    justify-content: end;
    li a {
      padding-inline: var(--sp-04);
      padding-block: var(--sp-05);
      text-shadow: var(--text-shadow-color);
      font-family: var(--font-display);
      font-size: var(--text-base);
      letter-spacing: var(--tracking-semiwide);
      color: inherit;
      @media (prefers-reduced-motion: no-preference) {
        transition: color 200ms ease;
      }
    }
    li:hover {
      color: var(--color-nav-hover);
    }
  }
  .footer-links > li a:focus-visible {
    outline: var(--keyboard-focus);
    outline-offset: 3px;
  }
  .footer-copyright {
    display: block;
    margin-inline-end: var(--sp-03);
    text-align: end;
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-semiwide);
  }

  /* TABLET */
  @media (max-width: 987px) {
    .footer-body {
      flex-direction: column;
    }
    .footer-links {
      justify-content: center;
      li a {
        padding-inline: var(--sp-03);
        padding-block: var(--sp-05-5);
      }
    }
    .footer-copyright {
      text-align: center;
    }
  }
</style>

<script>
  document.getElementById("footer-year")!.textContent = new Date()
    .getFullYear()
    .toString();
</script>
