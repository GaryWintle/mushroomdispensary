---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import CarouselArrow from "@components/artwork/CarouselArrow.astro";
import MushyGuySmiley from "@components/artwork/MushGuySmiley.astro";
import SectionHeader from "@components/ui/SectionHeader.astro";

interface Props {
  images: { src: ImageMetadata; alt: string; caption?: string }[];
  mobileHero?: boolean;
}
const { images, mobileHero = false } = Astro.props;
---

<section
  class:list={[
    "embla",
    "section",
    "section--dark",
    "container",
    { "embla--mobile-hero": mobileHero },
  ]}
  data-animation="photo-carousel"
  aria-label="Store photo gallery"
  aria-roledescription="carousel"
>
  <div class="photo-carousel-section-header-wrapper" data-animation="pc-header">
    <SectionHeader
      title="In Vancouver?"
      text=" We're your #1 source for psychedelics and plant medicines."
    />
  </div>
  <div class="embla__viewport" data-animation="pc-viewport">
    <div class="embla__container">
      {
        images.map((img, i) => (
          <div
            class="embla__slide"
            role="group"
            aria-roledescription="slide"
            aria-label={`${i + 1} of ${images.length}`}
          >
            <Image
              src={img.src}
              alt={img.alt}
              loading={i === 0 ? "eager" : "lazy"}
              draggable="false"
              widths={[640, 960, 1280]}
              sizes="(max-width: 640px) 640px, (max-width: 960px) 960px, 1280px"
              quality={80}
            />
            {img.caption && <p class="slide__caption">{img.caption}</p>}
          </div>
        ))
      }
    </div>
  </div>
  <div class="wrapper-mushyguy-smiley --desktop-only">
    <MushyGuySmiley />
  </div>
  <button
    class="embla__btn embla__btn--prev --desktop-only"
    aria-label="Previous slide"
  >
    <div class="arrow arrow--left"><CarouselArrow /></div>
  </button>
  <button
    class="embla__btn embla__btn--next --desktop-only"
    aria-label="Next slide"
  >
    <div class="arrow arrow--right"><CarouselArrow /></div>
  </button>
  <div class="embla__dots" aria-label="Slide navigation" role="tablist"></div>
</section>

<script>
  // --- GSAP block ---
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  document
    .querySelectorAll('[data-animation="photo-carousel"]')
    .forEach((emblaEl) => {
      const header = emblaEl.querySelector('[data-animation="pc-header"]');
      if (!header) return; // skip carousels with no section header

      gsap
        .timeline({
          scrollTrigger: { trigger: emblaEl, start: "top 80%" },
        })
        .from(header, { opacity: 0, y: 20, duration: 0.5, ease: "power2.out" })
        .from(emblaEl.querySelector('[data-animation="pc-viewport"]'), {
          opacity: 0,
          duration: 1,
          ease: "power2.out",
        });
    });
</script>

<style>
  .text-title-hero {
    flex: 1 0 none;
    color: var(--color-surface-dark-text-highlight);
    font-family: var(--font-display);
    font-size: clamp(1rem, 3.5vw, 3.5rem);
    text-transform: uppercase;
    text-box: trim-both cap alphabetic;
  }

  .text-body-display {
    flex: 1 0 25%;
    font-size: var(--text-lg);
  }

  .text-body {
    width: 90%;
  }

  .wrapper-twisty-arrow {
    position: absolute;
    top: 10px;
    right: -30px;
    transform: rotate(20deg);
    z-index: 2;
  }

  .embla--mobile-hero .embla__viewport {
    border: none;
    border-radius: 0;
    box-shadow: none;
  }

  .embla--mobile-hero .embla__slide {
    aspect-ratio: unset;
    height: 70svh;
    border-radius: 0;
  }

  .embla--mobile-hero .embla__slide img {
    border-radius: 0;
  }
  .embla--mobile-hero .embla__dots {
    display: none;
  }
  .embla--mobile-hero .slide__caption {
    display: none;
  }

  .embla {
    position: relative;
    overflow: clip;
    border-radius: 0;
    /* margin-bottom: 120px; */
  }

  .embla__viewport {
    overflow: hidden;
    cursor: grab;
    border: var(--border-photo-dark-thin);
    border-radius: var(--br-03);
    box-shadow: var(--card-shadow-neutral-deep);
  }

  .embla__viewport.is-dragging {
    cursor: grabbing;
  }

  .embla__container {
    display: flex;
    touch-action: pan-y; /* allows vertical scroll, horizontal swipe */
  }

  .embla__slide {
    position: relative;
    flex: 0 0 100%; /* one slide at a time */
    min-width: 0;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--br-03);
    /* padding-left: var(--sp-04); */
  }

  .embla__slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    pointer-events: none;
    border-radius: var(--br-03);
  }

  .slide__caption {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%) translateY(100%);
    padding: var(--sp-03) var(--sp-06);
    border-radius: var(--br-03) var(--br-03) 0 0;
    background-color: var(--color-secondary-200);
    /* background-color: var(--color-neutral-600-90); */
    border-left: var(--border-surface-color-thick);
    border-top: var(--border-surface-color-thick);
    border-right: var(--border-surface-color-thick);
    color: var(--color-neutral-200);
    font-family: var(--font-body);
    font-size: var(--text-base);
    letter-spacing: var(--tracking-loose);
    font-variation-settings:
      "wdth" 100,
      "wght" 700;
    opacity: 0;
    transition:
      opacity 250ms ease,
      transform 250ms ease;
  }

  .embla__slide:hover .slide__caption {
    transform: translateX(-50%) translateY(0);
    opacity: 1;
  }

  /* Position your buttons */
  .embla__btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    cursor: pointer;
    z-index: 2;
    padding: 0;
  }
  .embla__btn--prev,
  .embla__btn--next {
    transform: scale(1);
    transition: transform 250ms ease;
  }
  .embla__btn--prev:hover,
  .embla__btn--next:hover {
    transform: scale(1.05);
  }
  .embla__btn--prev {
    left: var(--sp-04);
    filter: var(--art-shadow-neutral-medium);
  }
  .embla__btn--next {
    right: var(--sp-04);
    filter: var(--art-shadow-neutral-medium);
  }
  .arrow--right {
    transform: rotate(180deg);
  }

  /* Dots */
  .embla__dots {
    display: flex;
    justify-content: center;
    gap: var(--sp-03);
    padding-block-start: var(--space-sub-section-block);
  }

  :global(.embla__dot) {
    width: 32px;
    height: 8px;
    border-radius: var(--br-01);
    border: 2px solid var(--color-secondary-200);
    background: transparent;
    cursor: pointer;
    padding: 0;
    transition: background 250ms ease;
    box-shadow: var(--card-shadow-neutral-shallow);
  }

  :global(.embla__dot.is-selected) {
    background: var(--color-primary-200);
  }

  .wrapper-mushyguy-smiley {
    width: 5rem;
    position: absolute;
    bottom: 140px;
    right: 0;
    z-index: 2;
    pointer-events: none;
    animation: bounce 2s ease-in-out infinite;
  }

  @media (max-width: 850px) {
    .section {
      padding-block: 0;
    }
    .container {
      width: 100%;
      margin-inline: auto;
      padding-inline: 0;
    }
    .--desktop-only {
      display: none;
    }
    .photo-carousel-section-header-wrapper {
      display: none;
    }
  }
</style>

<script>
  // --- Embla block ---
  import EmblaCarousel from "embla-carousel";
  import Autoplay from "embla-carousel-autoplay";

  document
    .querySelectorAll<HTMLElement>(".embla__viewport")
    .forEach((viewport) => {
      const root = viewport.closest(".embla")!;

      const embla = EmblaCarousel(
        viewport,
        {
          loop: true,
          dragFree: false,
          containScroll: "trimSnaps",
        },
        [Autoplay({ delay: 4000 })],
      );

      root
        .querySelector(".embla__btn--prev")
        ?.addEventListener("click", () => embla.scrollPrev());
      root
        .querySelector(".embla__btn--next")
        ?.addEventListener("click", () => embla.scrollNext());

      viewport.addEventListener("pointerdown", () =>
        viewport.classList.add("is-dragging"),
      );
      viewport.addEventListener("pointerup", () =>
        viewport.classList.remove("is-dragging"),
      );

      const dotsContainer = root.querySelector(".embla__dots")!;
      const dots = embla.scrollSnapList().map((_, i) => {
        const dot = document.createElement("button");
        dot.className = "embla__dot";
        dot.setAttribute("role", "tab");
        dot.setAttribute("aria-label", `Go to slide ${i + 1}`);
        dot.addEventListener("click", () => embla.scrollTo(i));
        dotsContainer.appendChild(dot);
        return dot;
      });

      const updateDots = () => {
        dots.forEach((dot, i) =>
          dot.classList.toggle("is-selected", i === embla.selectedScrollSnap()),
        );
      };
      embla.on("select", updateDots);
      updateDots();

      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        embla.reInit({ duration: 0 });
      }

      const updateSelected = () => {
        embla
          .slideNodes()
          .forEach((slide, i) =>
            slide.classList.toggle(
              "is-active",
              i === embla.selectedScrollSnap(),
            ),
          );
      };
      embla.on("select", updateSelected);
      updateSelected();
    });
</script>
