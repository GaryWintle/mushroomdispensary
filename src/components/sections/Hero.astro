---
import Smiley from "@components/artwork/Smiley.astro";
import SeenOnTV from "@components/artwork/SeenOnTV.astro";
import CanadaFlag from "@components/artwork/CanadaFlag.astro";
import CTAButton from "@components/ui/CTAButton.astro";
---

<section class="section section--light hero">
  <div class="container">
    <div class="hero-grid">
      <div class="hero-card">
        <div class="icon-smiley">
          <Smiley />
        </div>
        <h1 class="hero-title">
          Dedicated to&#8200;a&#8200;safe, psychedelic supply
        </h1>

        <p class="hero-text-body">
          We believe in the benefits of psychedelics and want to challenge
          <span class="inline-icon">
            <CanadaFlag />
          </span>
          's failed drug prohibition laws.
        </p>
        <div class="hero-cta-button">
          <CTAButton text="Our Story" href="/about" onLight />
          <CTAButton text="Full Menu" href="/about" onLight />
        </div>
      </div>
      <div class="hero-video desktop-only">
        <div class="video-wrapper">
          <div class="icon-seen-on-tv">
            <SeenOnTV />
          </div>
          <!-- To re-enable autoplay, add autoplay=1& before mute=1 in the src -->
          <div class="video-overlay"></div>
          <iframe
            src="https://www.youtube-nocookie.com/embed/0rFVeZ9mpe0?autoplay=1&mute=1&loop=1&playlist=0rFVeZ9mpe0&controls=0&modestbranding=1&rel=0"
            title="Hero video"
            loading="eager"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen></iframe>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    container-type: inline-size;
    container-name: hero;
    padding-block-start: var(--sp-07);
    padding-block-end: var(--sp-05);
    overflow: clip;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 2fr;
    align-items: start;
    gap: var(--sp-04);
  }

  .hero-card {
    position: relative;
    display: grid;
    gap: var(--sp-04);
    align-self: stretch;
    background-color: var(--color-surface-light);
    border-radius: var(--br-03);
    padding-block: var(--body-padding-block);
    padding-inline: var(--body-padding-inline);
    box-shadow: var(--card-shadow-neutral-deep);
  }
  .hero-title {
    font-size: var(--text-hero);
    text-transform: uppercase;
    text-wrap: balance;
    text-box: trim-both cap alphabetic;
    line-height: 1;
  }

  .hero-text-body {
    width: 100%;
    text-box: trim-both cap alphabetic;
  }

  .hero-cta-button {
    display: flex;
    align-self: end;
    gap: var(--sp-04);
  }

  .hero-video {
    border-radius: var(--br-03);
    box-shadow: var(--card-shadow-neutral-deep);
    aspect-ratio: 16 / 9;
  }

  .video-wrapper {
    position: relative;
    aspect-ratio: 16 / 9;
    &::before {
      content: "";
      position: absolute;
      z-index: 1;
      inset: 0;
      pointer-events: none;
      box-shadow: inset 0 0 35px 5px var(--color-neutral-600-50);
    }
    &::after {
      content: "";
      position: absolute;
      z-index: 1;
      inset: 0.625rem;
      pointer-events: none;
      border-radius: var(--br-02);
      box-shadow: inset 0 0 0 2px
        oklch(from var(--color-primary-200) l c h / 0.8);
    }
    & iframe {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border: 0;
      border-radius: var(--br-03);
    }
  }

  .video-wrapper:hover .video-overlay {
    pointer-events: none;
  }

  .video-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    cursor: default;
  }

  .inline-icon {
    display: inline-flex;
    align-items: center;
    vertical-align: middle;
  }

  .inline-icon svg {
    width: 1em;
    height: auto;
  }
  .icon-seen-on-tv {
    position: absolute;
    z-index: 2;
    right: 0;
    bottom: 0;
    transform: translate(35%, -20%) rotate(35deg);
  }

  .icon-seen-on-tv :global(svg) {
    width: 9rem;
    height: 9rem;
    filter: var(--art-shadow-neutral-medium);
  }

  .icon-smiley {
    position: absolute;
    top: 0;
    right: 0;
    transform: translate(-17%, 45%) rotate(16deg);
    filter: var(--art-shadow-color-shallow);
  }

  .icon-smiley :global(svg) {
    width: 4.5rem;
    height: 4.5rem;
  }

  @container hero (max-width: 1177px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .hero-card {
      flex-direction: row;
      gap: var(--sp-fluid-03);
      place-items: center;
      text-align: center;
      border-radius: 0 0 var(--br-03) var(--br-03);
      border-top: var(--border-photo-dark-thin);
    }
    .hero-title {
      width: min(100%, 25ch);
      font-size: var(--text-hero);
    }
    .hero-text-body {
      text-box: trim-both cap alphabetic;
      width: min(100%, 55ch);
    }
    .hero-cta-button {
      width: min(100%, 70%);
    }
    .hero-video {
      order: -1;
      box-shadow: var(--card-shadow-neutral-deep);
      aspect-ratio: 16 / 9;
    }
    .video-wrapper iframe {
      border-radius: var(--br-03) var(--br-03) 0 0;
    }
    .icon-seen-on-tv {
      position: absolute;
      right: 0;
      bottom: 0;
      transform: translate(20%, -160%) rotate(35deg);
      z-index: 2;
    }

    .icon-seen-on-tv :global(svg) {
      width: 9rem;
      height: 9rem;
      filter: var(--art-shadow-neutral-medium);
    }
    .icon-smiley {
      transform: translate(20%, 155%) rotate(16deg);
    }

    .icon-smiley :global(svg) {
      width: 5rem;
      height: 5rem;
    }
  }

  @media (max-width: 850px) {
    .hero {
      overflow: visible; /* allows hero-card to overlap video via negative margin-top */
    }
  }

  @container hero (max-width: 850px) {
    .hero-card {
      flex-direction: column;
      gap: var(--sp-fluid-02);
      border: var(--border-photo-dark-default);
      border-radius: var(--br-03);

      place-items: start;
      text-align: start;
      margin-top: -80px;
      z-index: 2;
    }

    .icon-seen-on-tv {
      transform: translate(20%, -60%) rotate(35deg);
      z-index: 2;
      display: none;
    }

    .icon-seen-on-tv :global(svg) {
      width: 9rem;
      height: 9rem;
    }
    .icon-smiley {
      transform: translate(-20%, -25%) rotate(16deg);
    }

    .icon-smiley :global(svg) {
      width: 4rem;
      height: 4rem;
    }
    .desktop-only {
      display: none;
    }
  }

  @media (max-width: 500px) {
    .hero-cta-button {
      width: 100%;
      display: flex;
      flex-direction: column;
      align-self: stretch;
      gap: var(--sp-04);
    }
  }
</style>
