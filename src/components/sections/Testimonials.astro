---

<section
  class="section--colored testimonials container"
  aria-label="Press mentions"
  data-animation-testimonials
>
  <div class="testimonials-flex" role="list">
    <div class="testimonial" role="listitem" data-animation-testimonial-card>
      <blockquote class="testimonial-quote">
        “There’s no shortage of members at Larsen’s cafe and dispensary - more
        than 20,000 at last count.”
      </blockquote>
      <cite class="testimonials-organization-name">VICE</cite>
    </div>

    <div class="testimonial" role="listitem" data-animation-testimonial-card>
      <blockquote class="testimonial-quote">
        “...magic mushroom dispensaries... brazenly advertise their wares on
        three of the city’s busiest thoroughfares.”
      </blockquote>
      <cite class="testimonials-organization-name">Globe and Mail</cite>
    </div>

    <div class="testimonial" role="listitem" data-animation-testimonial-card>
      <blockquote class="testimonial-quote">
        “Buying magic mushrooms... can be as easy as ordering your morning cup
        of coffee.”
      </blockquote>
      <cite class="testimonials-organization-name">CBC News</cite>
    </div>
  </div>
</section>

<style>
  .testimonials-flex {
    display: flex;
    gap: var(--sp-04);
  }
  .testimonial {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: space-between;
    padding-inline: var(--sp-06);
    padding-block: var(--sp-07);
    background-color: var(--color-neutral-600-50);
    border-radius: var(--br-03);
    box-shadow: var(--card-shadow-neutral-deep);
    border: var(--border-surface-dark-thin);
  }

  .testimonial:nth-child(2) {
    flex: 1.2; /* gives the middle card slightly more visual weight */
  }

  .testimonial-quote {
    margin-block-end: var(--sp-04);
    font-family: var(--font-body);
    font-size: var(--text-lg);
    line-height: var(--leading-loose);
    font-style: italic;
    text-wrap: balance;
  }

  .testimonials-organization-name {
    font-family: var(--font-display);
    font-size: var(--text-base);
    color: var(--color-surface-colored-text-highlight);
    &::before {
      content: "• ";
    }
  }
  /* TABLET */
  @media (max-width: 900px) {
    .testimonials-flex {
      overflow-x: scroll;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      margin-inline: calc(-1 * var(--space-section-inline));
      padding-inline: var(--space-section-inline);
      scroll-padding-inline: var(--space-section-inline);
      mask-image: linear-gradient(
        to right,
        transparent,
        black 7%,
        black 93%,
        transparent
      );
      -webkit-mask-image: linear-gradient(
        to right,
        transparent,
        black 10%,
        black 90%,
        transparent
      );
    }
    .testimonial {
      flex: 0 0 85%;
      scroll-snap-align: start;
      border: var(--border-surface-dark-thinnest);
    }
    .testimonial:nth-child(2) {
      flex: 0 0 85%;
    }
    .testimonial-quote {
      line-height: 1.5;
    }
    .testimonials-organization-name {
      font-size: var(--text-lg);
    }
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  gsap.from("[data-animation-testimonial-card]", {
    scrollTrigger: {
      trigger: "[data-animation-testimonials]",
      start: "top 80%",
    },
    opacity: 0,
    y: 20,
    duration: 0.8,
    ease: "power2.out",
    stagger: 0.15,
  });
</script>
