---
import type { NewsItem } from "@data/news";

type Props = NewsItem;

const {
  title,
  url,
  source,
  date,
  datetime,
  year,
  featured = false,
  badge = "Landmark",
  blurb,
} = Astro.props;
---

<li
  class:list={[
    "news-card-wrapper",
    { "news-card-wrapper--featured": featured },
  ]}
  data-year={year}
>
  <a
    class="news-card-link"
    href={url}
    target="_blank"
    rel="noopener noreferrer"
    data-animation="news-card"
    aria-label={`${title} — ${source}, ${date} (opens in a new tab)`}
  >
    <article
      class:list={[
        "news-card",
        featured ? "section--colored" : "section--light",
        { "news-card--featured": featured },
      ]}
    >
      <!-- {featured && <span class="news-card-badge">{badge}</span>} -->

      <div class="news-card-main">
        <div class="news-card-top">
          <span class="news-card-source">{source}</span>
          <time class="news-card-date" datetime={datetime}>{date}</time>
        </div>
        <h3 class="news-card-title">{title}</h3>
        <!-- <span class="news-card-readmore" aria-hidden="true"> Read story </span> -->
      </div>

      {featured && blurb && <p class="news-card-blurb">{blurb}</p>}
    </article>
  </a>
</li>

<style>
  /* The <li> is the grid item; the link fills it so cards stretch evenly. */
  .news-card-link {
    display: block;
    height: 100%;
    transform: translate(0, 0);
    transition: transform 150ms ease-in;
  }

  .news-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    gap: var(--sp-04);
    background: var(--color-surface-light);
    border-radius: var(--br-03) 3rem var(--br-03) var(--br-03);
    box-shadow: var(--card-shadow-neutral-medium);
    padding-block: var(--card-padding-block);
    padding-inline: var(--sp-05);
    transition: box-shadow 200ms ease-in-out;
  }

  .news-card-main {
    display: flex;
    flex-direction: column;
    gap: var(--sp-04);
    height: 100%;
  }

  .news-card-top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-02) var(--sp-04);
    padding-block-end: var(--sp-03);
    border-block-end: var(--border-surface-dark-thin);
  }
  .news-card-source {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--color-surface-light-text-highlight);
  }
  .news-card-date {
    font-size: var(--text-xsm);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    font-variation-settings: var(--fvs-regular-regular);
    color: var(--color-neutral-500);
    white-space: nowrap;
  }

  .news-card-title {
    flex: 1;
    font-family: var(--font-body);
    font-size: var(--text-lg);
    font-variation-settings:
      "wdth" 95,
      "wght" 650;
    line-height: var(--leading-normal);
    letter-spacing: normal;
    text-wrap: pretty;
    color: var(--color-surface-light-text);
    transition: color 200ms ease-in;
  }

  .news-card-readmore {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-02);
    margin-block-start: var(--sp-01);
    font-family: var(--font-display);
    font-size: var(--text-base);
    color: var(--color-surface-light-text-highlight);
  }
  .news-card-arrow {
    display: inline-block;
    transition: transform 200ms ease;
  }

  /* HOVER / FOCUS — lift + chunky colored shadow, like the product cards */
  .news-card-link:focus-visible {
    outline: none;
    transform: translate(-2px, -5px);
  }
  .news-card-link:focus-visible .news-card {
    box-shadow:
      0 0 0 4px var(--color-neutral-600),
      var(--card-shadow-color-deep);
  }
  .news-card-link:focus-visible .news-card-title {
    color: var(--color-surface-light-text-highlight);
  }
  .news-card-link:focus-visible .news-card-arrow {
    transform: translateX(4px);
  }

  @media (hover: hover) {
    .news-card-link:hover {
      transform: translate(-2px, -5px);
    }
    .news-card-link:hover .news-card {
      box-shadow:
        0 0 0 4px var(--color-neutral-600),
        var(--card-shadow-color-deep);
    }
    .news-card-link:hover .news-card-title {
      color: var(--color-surface-light-text-highlight);
    }
    .news-card-link:hover .news-card-arrow {
      transform: translateX(4px);
    }
  }

  /* ---------------------------------------------------------------------- */
  /* FEATURED HERO — wide brand-pink landmark card, larger type + quote      */
  /* ---------------------------------------------------------------------- */
  /* Default to a single column so it never forces a phantom column on
     mobile/tablet. Only span two columns once the grid is wide enough to
     actually have them (matches the ~400px-min auto-fill grid). */
  .news-card-wrapper--featured {
    grid-column: auto;
  }
  @media (min-width: 900px) {
    .news-card-wrapper--featured {
      grid-column: 1 / 3;
    }
  }

  .news-card--featured {
    position: relative;
    flex-direction: row;
    align-items: stretch;
    gap: var(--sp-fluid-03);
    background: var(--color-surface-colored);
    box-shadow: var(--card-shadow-neutral-deep);
    padding-block: var(--body-padding-block);
    padding-inline: var(--sp-fluid-02);
  }

  .news-card--featured .news-card-main {
    flex: 1 1 22rem;
    min-width: 0;
  }
  .news-card--featured .news-card-top {
    border-block-end-color: var(--color-primary-200);
  }
  .news-card--featured .news-card-source {
    color: var(--color-surface-colored-text-highlight);
  }
  .news-card--featured .news-card-date {
    color: var(--color-primary-100);
    opacity: 0.85;
  }
  .news-card--featured .news-card-title {
    flex: 0 0 auto;
    font-family: var(--font-display);
    font-size: var(--text-hero);
    font-variation-settings: normal;
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
    color: var(--color-surface-colored-text);
  }
  .news-card--featured .news-card-readmore {
    margin-block-start: auto;
    font-size: var(--text-lg);
    color: var(--color-surface-colored-text-highlight);
  }

  .news-card-badge {
    position: absolute;
    top: 0;
    right: var(--sp-05);
    transform: translateY(-50%);
    display: inline-flex;
    align-items: center;
    padding-inline: var(--button-inline-sm);
    padding-block: var(--button-block-sm);
    border-radius: var(--br-02);
    background: var(--color-primary-200);
    color: var(--color-neutral-600);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-semiwide);
    text-transform: uppercase;
    box-shadow: var(--card-shadow-neutral-shallow);
  }

  .news-card-blurb {
    flex: 1 1 18rem;
    min-width: 0;
    align-self: center;
    margin: 0;
    padding-inline-start: var(--sp-05);
    border-inline-start: var(--border-thick) solid var(--color-primary-200);
    font-size: var(--text-lg);
    line-height: var(--leading-loose);
    font-variation-settings: var(--fvs-regular-regular);
    text-wrap: pretty;
    color: var(--color-surface-colored-text);
  }

  /* Featured hover keeps a dark chunky shadow against the pink surface. */
  @media (hover: hover) {
    .news-card-link:hover .news-card--featured {
      box-shadow:
        0 0 0 4px var(--color-neutral-600),
        var(--card-shadow-color-primary-deep);
    }
    .news-card-link:hover .news-card--featured .news-card-title {
      color: var(--color-neutral-100);
    }
  }
  .news-card-link:focus-visible .news-card--featured {
    box-shadow:
      0 0 0 4px var(--color-primary-200),
      var(--card-shadow-neutral-deep);
  }
  .news-card-link:focus-visible .news-card--featured .news-card-title {
    color: var(--color-neutral-100);
  }

  @media (prefers-reduced-motion: reduce) {
    .news-card-link,
    .news-card,
    .news-card-arrow {
      transition: none;
    }
  }

  /* TABLET / MOBILE — featured stacks into a single column.
     Reset the row-layout sizing so the title, "Read story" and blurb sit
     naturally instead of being stretched apart by the desktop height rules. */
  @media (max-width: 800px) {
    .news-card--featured {
      flex-direction: column;
    }
    .news-card--featured .news-card-main {
      flex: 0 0 auto;
      height: auto;
    }
    .news-card--featured .news-card-readmore {
      margin-block-start: var(--sp-04);
    }
    .news-card-blurb {
      flex: 0 0 auto;
      align-self: stretch;
      padding-inline-start: var(--sp-04);
    }
    .news-card-badge {
      right: var(--sp-04);
    }
  }

  @media (max-width: 600px) {
    .news-card--featured .news-card-title {
      font-size: var(--text-xl);
    }
  }
</style>
