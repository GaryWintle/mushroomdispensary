---
import LocationsHeader from "@components/ui/LocationsHeader.astro";
import LocationCard from "@components/ui/LocationCard.astro";
import AdultsOnly from "@components/ui/AdultsOnly.astro";

// Map Photos
import location1 from "@images/locations/Map01-davie.png";
import location2 from "@images/locations/Map02-eastvancouver.png";
import location3 from "@images/locations/Map03-mountpleasant.png";

// Numbered Icons
import LocationIcon01 from "@images/location1.svg?raw";
import LocationIcon02 from "@images/location2.svg?raw";
import LocationIcon03 from "@images/location3.svg?raw";
import SectionHeader from "@components/ui/SectionHeader.astro";

//Location & Hours Data
const locations = [
  {
    cityArea: "West End Vancouver",
    address: "1674 Davie St.",
    storeHours: [
      { days: "Mon-Wed", hours: "11am-7pm" },
      { days: "Thu-Sat", hours: "10am-11pm" },
      { days: "Sun", hours: "11am-6pm" },
    ],
    image: location1,
    locationIcon: LocationIcon01,
    href: "https://maps.app.goo.gl/ZWsd2aXFoNPHkgMFA",
  },
  {
    cityArea: "East Vancouver",
    address: "651 East Hastings",
    storeHours: [
      { days: "Mon-Thu", hours: "10am-10pm" },
      { days: "Fri-Sat", hours: "10am-11pm" },
      { days: "Sun", hours: "11am-6pm" },
    ],
    image: location2,
    locationIcon: LocationIcon02,
    href: "https://maps.app.goo.gl/fSV8WLYfYqDHX6oY8",
  },
  {
    cityArea: "Mount Pleasant",
    address: "247 West Broadway",
    storeHours: [
      { days: "Mon-Wed", hours: "11am-7pm" },
      { days: "Thu-Sat", hours: "10am-10pm" },
      { days: "Sun", hours: "11am-6pm" },
    ],
    image: location3,
    locationIcon: LocationIcon03,
    href: "https://maps.app.goo.gl/obv896WAwTtwXzNX7",
  },
];
---

<section id="contact-section" class="section section--dark container contact">
  <SectionHeader
    title="3 Locations!"
    text="We have three safe, psychedlic storefronts in Vancouver, BC, Canada"
    sectionName="product"
  />
  <div class="contact-container">
    <LocationsHeader />
    <div class="locations-card">
      {
        locations.map((location) => (
          <LocationCard
            cityArea={location.cityArea}
            address={location.address}
            storeHours={location.storeHours}
            image={location.image}
            locationIcon={location.locationIcon}
            href={location.href}
          />
        ))
      }
    </div>
    <div class="contact-container-adults-only">
      <AdultsOnly />
    </div>
  </div>
</section>

<style>
  .contact-container {
    display: grid;
    grid-template-columns: 1fr 2fr;
    grid-template-areas: "sidebar cards";
    gap: var(--sp-05);
  }
  .locations-card {
    grid-area: cards;
    display: flex;
    flex-direction: column;
    gap: var(--sp-04);
  }
  .contact-container-adults-only {
    display: none;
  }

  @media (max-width: 1135px) {
    .contact-container {
      grid-template-columns: 1fr;
      grid-template-areas:
        "sidebar"
        "cards";
      gap: var(--sp-05);
    }
    .contact-container-adults-only {
      display: revert;
    }
  }

  @media (max-width: 650px) {
    .locations-card {
      flex-direction: row;
      overflow-x: scroll;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      margin-inline: calc(-1 * var(--space-section-inline));
      padding-inline: var(--space-section-inline);
      scroll-padding-inline: var(--space-section-inline);
      mask-image: linear-gradient(
        to right,
        transparent,
        black 7%,
        black 93%,
        transparent
      );
      -webkit-mask-image: linear-gradient(
        to right,
        transparent,
        black 7%,
        black 93%,
        transparent
      );
    }
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const tl = gsap.timeline({
    scrollTrigger: {
      trigger: ".contact",
      start: "top 80%",
    },
  });

  tl.from(".locations-header-container", {
    opacity: 0,
    y: 20,
    duration: 0.5,
    ease: "power2.out",
  }).from(
    ".locations-card .location-card",
    {
      opacity: 0,
      duration: 1,
      ease: "power2.out",
      stagger: 0.25,
    },
    "+=0.1",
  );
</script>
