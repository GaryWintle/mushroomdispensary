---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import FreeUserGuideIcon from "./FreeUserGuideIcon.astro";

interface Props {
  title: string;
  description: string;
  image: ImageMetadata;
  hasGuide: boolean;
  href: string;
}

const {
  title = "Mushroom Dispensary",
  description = "This is just default text!",
  image,
  hasGuide = false,
  href = "/products",
} = Astro.props;
---

<a class="card-wrapper" href={href}>
  <div class="product-card section--light">
    <div class="card-image">
      <Image src={image} loading="lazy" width={600} height={400} alt={title} />
    </div>
    <div class="card-text-body">
      <h3 class="card-title">{title}</h3>
      <p class="card-description">{description}</p>
    </div>
  </div>
  {
    hasGuide && (
      <div class="user-guide">
        <FreeUserGuideIcon />
      </div>
    )
  }
</a>

<style>
  .card-wrapper {
    display: block;
    position: relative;
    transform: translate(0, 0);
    transition: transform 150ms ease-in;
  }
  .card-wrapper:focus-visible {
    transform: translate(-2px, -5px);
  }
  .card-wrapper:focus-visible .card-title {
    color: var(--color-surface-light-text-highlight);
  }

  .product-card {
    display: flex;
    flex-direction: column;
    background: var(--color-surface-light);
    /* border: var(--border-photo-dark-thin); */
    border-radius: var(--br-03) 3rem var(--br-03) var(--br-03);
    height: 100%;
    overflow: hidden;
    box-shadow: var(--card-shadow-neutral-medium);
    transition: box-shadow 200ms ease-in-out;
  }
  .product-card:focus-visible {
    box-shadow:
      0 0 0 4px var(--color-neutral-600),
      var(--card-shadow-color-deep);
    border: none;
    /* border: var(--border-surface-color-thick); */
  }

  .card-image {
    height: auto;
    aspect-ratio: 4 / 3;
    border-bottom: var(--border-surface-color-thick);
    overflow: hidden;
    & img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
  }
  .card-text-body {
    flex: 1;
    padding-block-start: var(--sp-06);
    padding-block-end: var(--sp-07);
    padding-inline: var(--sp-05);
  }

  .card-title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    margin-block-end: var(--sp-02);
    letter-spacing: var(--tracking-loose);
    line-height: var(--leading-tight);
    /* text-transform: uppercase; */
    text-wrap: balance;
    transition: color 200ms ease-in;
  }

  .card-description {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
    letter-spacing: var(--tracking-normal);
    font-variation-settings: var(--fvs-regular-regular);
    text-wrap: pretty;
  }

  .user-guide {
    position: absolute;
    right: -18px;
    top: 38%;
    transform: rotate(15deg);
    filter: var(--art-shadow-neutral-medium);
    transition: filter 200ms ease-in;
  }

  @media (hover: hover) {
    .card-wrapper:hover {
      transform: translate(-2px, -5px);
    }
    .card-wrapper:hover .card-title {
      color: var(--color-surface-light-text-highlight);
    }
    .product-card:hover {
      box-shadow:
        0 0 0 4px var(--color-neutral-600),
        var(--card-shadow-color-deep);
      border: unset;
    }
  }

  @media (max-width: 600px) {
    .card-wrapper {
      scroll-snap-align: start;
    }
    .card-image {
      aspect-ratio: 4 / 3.5;
    }
    .card-title {
      letter-spacing: var(--tracking-tight);
    }
    .card-description {
      line-height: var(--leading-loose);
    }
    .card-text-body {
      flex: 1;
      padding-block-end: var(--sp-05);
    }
    .user-guide {
      position: absolute;
      right: -18px;
      top: 41%;
    }
  }
</style>
