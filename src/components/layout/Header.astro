---
import MushDispLogo from "@components/artwork/MushDispLogo.astro";
import MushDispLogoMobile from "@components/artwork/MushDispLogoMobile.astro";
import MushDispLogoText from "@components/artwork/MushDispLogoText.astro";
import Hamburger from "@images/mushdisp-hamburger-default.svg?raw";
import HamburgerClose from "@images/mushdisp-hamburger-close.svg?raw";
import MushyGuySmiley from "@components/artwork/MushGuySmiley.astro";
---

<header class="section--colored nav">
  <div class="container">
    <nav class="nav-flex">
      <div class="nav-logo-container">
        <div class="nav-logo --hidden-on-mobile"><MushDispLogo /></div>
        <div class="nav-logo --hidden-on-desktop"><MushDispLogoMobile /></div>
        <div class="logo-text-container">
          <MushDispLogoText />
          <p class="logo-text-subheading --hidden-on-mobile">
            Mushrooms • DMT • Peyote • Kratom • LSD
          </p>
        </div>
      </div>
      <ul class="nav-links-flex --hidden-on-mobile">
        <li>Our Story</li>
        <li>News</li>
        <li>Contact</li>
        <li>Menu</li>
      </ul>
      <button
        class="hamburger-btn --hidden-on-desktop"
        data-menu-trigger
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open navigation menu"
      >
        <Fragment set:html={Hamburger} />
      </button>
    </nav>
  </div>
  <dialog id="mobile-menu" class="mobile-nav" aria-label="Navigation menu">
    <div class="mobile-menu-inner-container">
      <button
        class="drawer-close"
        data-menu-close
        aria-label="Close navigation menu"
      >
        <Fragment set:html={HamburgerClose} />
      </button>
      <ul class="nav-links-flex-mobile">
        <li>Our Story</li>
        <li>News</li>
        <li>Contact</li>
        <li>Menu</li>
      </ul>
      <div class="wrapper-mushyguy-smiley --desktop-only">
        <MushyGuySmiley />
      </div>
    </div>
  </dialog>
</header>

<script>
  const trigger = document.querySelector("[data-menu-trigger]");
  const menu = document.querySelector("#mobile-menu") as HTMLDialogElement;
  const close = document.querySelector("[data-menu-close]");

  trigger?.addEventListener("click", () => {
    if (menu.open) {
      menu.close();
    } else {
      menu.showModal();
    }
  });

  close?.addEventListener("click", () => menu.close());

  menu?.addEventListener("click", (e) => {
    if (e.target === menu) menu.close();
  });

  menu?.querySelectorAll("li").forEach((link) => {
    link.addEventListener("click", () => menu.close());
  });

  menu?.addEventListener("toggle", () => {
    trigger?.setAttribute("aria-expanded", String(menu.open));
  });
</script>

<style>
  .nav {
    padding-block-start: var(--sp-06);
  }

  .nav-flex {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--sp-04);
    background-color: var(--color-nav);
    padding-inline-start: 5.2rem;
    padding-inline-end: var(--sp-05);
    border-radius: var(--br-03);
    justify-content: space-between;
    box-shadow: var(--card-shadow-neutral-deep);
  }

  .nav-links-flex {
    display: flex;
    color: var(--color-nav-text);
  }

  .nav-links-flex > li {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-semiwide);
    padding-inline: var(--sp-04);
    padding-block: var(--sp-05-5);
    border-left: var(--border-surface-color-thin);
    text-shadow: var(--text-shadow-color);
    transition:
      color 200ms ease,
      background-color 200ms ease;
  }

  .nav-links-flex > li:hover {
    color: var(--color-nav-text-hover);
    background-color: var(--color-nav-hover);
    text-shadow: none;
    cursor: pointer;
  }

  .logo-text-container {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .logo-text-subheading {
    color: var(--color-primary-200);
    font-family: var(--font-body);
    font-size: var(--text-xsm);
    letter-spacing: 0.17em;
    text-transform: uppercase;
    line-height: 1;
    font-variation-settings:
      "wdth" 100,
      "wght" 800;
    text-shadow: var(--text-shadow-color);
  }
  .--hidden-on-desktop {
    display: none;
  }

  /* MOBILE MENU */

  @media (max-width: 987px) {
    .nav {
      padding-block-start: env(safe-area-inset-top);
      position: sticky;
      z-index: 1000;
      top: 0;
    }
    .mobile-menu-inner-container {
      display: flex;
      flex-direction: column;
      gap: 25%;
      align-items: center;
      justify-content: space-between;
    }
    .nav-logo-container {
      display: flex;
      align-items: center;
      gap: var(--sp-03);
      padding-block: var(--sp-01);
    }

    .--hidden-on-desktop {
      display: unset;
    }
    .--hidden-on-mobile {
      display: none;
    }
    .container {
      width: 100%;
      padding-inline: 0;
    }
    .nav-flex {
      background-color: oklch(from var(--color-nav) l c h / 0.9);

      padding-inline-start: var(--sp-05);
      padding-inline-end: var(--sp-05);
      border-radius: 0;
      justify-content: space-between;
      border-bottom: var(--border-surface-color-thin);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      box-shadow: unset;
    }
    .mobile-nav {
      display: flex;
      flex-direction: column;
      justify-content: center;
      position: fixed;
      inset-block-start: 0;
      inset-inline-end: 0;
      inset-block-end: 0;
      inset-inline-start: auto;
      width: 75%;
      height: 100dvh;
      margin: 0;
      border: none;
      background: var(--color-nav);
      border-radius: var(--br-03) 0 0 var(--br-03);

      translate: 100% 0;
      transition:
        translate 400ms cubic-bezier(0.32, 0.72, 0, 1),
        overlay 400ms allow-discrete,
        display 400ms allow-discrete;
    }

    .mobile-nav[open] {
      translate: 0 0;
    }
    .nav-links-flex-mobile {
      display: flex;
      flex-direction: column;
      align-items: end;
      gap: var(--sp-07);
    }
    .nav-links-flex-mobile li {
      color: var(--color-nav-text);
      font-family: var(--font-display);
      font-size: var(--text-hero);
      text-transform: uppercase;
      text-wrap: balance;
      text-box: trim-both cap alphabetic;
      line-height: 1.05;
    }
    .drawer-close {
      align-self: self-end;
    }

    @starting-style {
      .mobile-nav[open] {
        translate: 100% 0;
      }
    }

    .mobile-nav::backdrop {
      background: hsl(0 0% 0% / 0);
      backdrop-filter: blur(0px);
      transition:
        background 400ms ease,
        backdrop-filter 400ms ease,
        overlay 400ms allow-discrete,
        display 400ms allow-discrete;
    }

    .mobile-nav[open]::backdrop {
      background: hsl(0 0% 0% / 0.35);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
    }

    @starting-style {
      .mobile-nav[open]::backdrop {
        background: hsl(0 0% 0% / 0);
        backdrop-filter: blur(0px);
      }
    }
  }
</style>
