---
import CTAButton from "@components/ui/CTAButton.astro";
import ProductGrid from "@components/ui/ProductGrid.astro";
import SectionHeader from "@components/ui/SectionHeader.astro";
import MushyGuyHazy from "@images/mushyguyHazy.svg?raw";
---

<section class="section section--dark container">
  <div class="products" data-animation="products-wrapper">
    <SectionHeader
      title="Our Products"
      text="No other shop in the world carries the same range of products that we do!"
      sectionName="product"
      hasArrow
    />
    <ProductGrid limit={8} />
    <div class="products-cta">
      <div class="products-cta-button">
        <CTAButton text="View Our Full Menu!" href="/products" />
      </div>
      <div class="products-mushy-guy">
        <Fragment set:html={MushyGuyHazy} />
      </div>
    </div>
  </div>

  <style>
    .products-cta {
      position: relative;
      display: grid;
      place-content: center;
    }
    .products-mushy-guy {
      position: absolute;
      top: -120%;
      right: calc(50% - 20rem);
      z-index: 2;
      width: 8rem;
      pointer-events: none;
      rotate: 8deg;

      @media (prefers-reduced-motion: no-preference) {
        animation: bounce 2s ease-in-out infinite;
      }
    }

    @keyframes bounce {
      0%,
      100% {
        transform: translateY(0);
      }
      50% {
        transform: translateY(-3px);
      }
    }

    /* MOBILE */
    .products-cta-button {
      display: grid;
      text-align: center;
    }
    .products-mushy-guy {
      top: -120%;
      right: calc(50% - 14rem);
      width: 6rem;
    }
  </style>

  <script>
    import gsap from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    gsap.registerPlugin(ScrollTrigger);

    const productsWrapper = document.querySelector(
      '[data-animation="products-wrapper"]',
    );
    const productHeader = document.querySelector(
      '[data-animate="product-header"]',
    );
    const productCards = document.querySelectorAll(
      '[data-animation="product-card"]',
    );

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: productsWrapper,
        start: "top 80%",
      },
    });

    tl.from(productHeader, {
      opacity: 0,
      y: 20,
      duration: 0.5,
      ease: "power2.out",
    }).from(
      productCards,
      {
        opacity: 0,
        duration: 1,
        ease: "power2.out",
        stagger: 0.1,
      },
      "+=0.1",
    );
  </script>
</section>
