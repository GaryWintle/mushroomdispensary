---
import PhoneIllo from "@components/artwork/PhoneIllo.astro";
import AdultsOnly from "./AdultsOnly.astro";
---

<div class="locations-header">
  <p class="locations-header-text">Same phone number for all locations:</p>
  <div class="illo-container">
    <PhoneIllo />
  </div>
  <div class="bottom-text-container">
    <a href="tel:+16043434687" class="subtitle --phonenumber">604-343-4687</a>
  </div>
  <div class="locations-header-container-adults-only">
    <AdultsOnly />
  </div>
</div>

<style>
  .locations-header {
    position: relative;
    grid-area: sidebar;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-07);
    padding-block: var(--sp-07) var(--sp-08);
    padding-inline: var(--sp-06);
    border: var(--border-surface-dark-thinnest);
    border-radius: var(--br-03);
    background-color: var(--color-neutral-600-50);
  }
  .locations-header-text {
    text-align: center;
  }
  .--phonenumber {
    font-family: var(--font-display);
    font-size: clamp(1.7rem, calc(3vw + 1rem), 3rem);
    text-transform: uppercase;
  }

  .--desktop-only {
    display: block;
  }
  .--mobile-only {
    display: none;
  }

  @media (max-width: 1135px) {
    .header-text-container {
      margin-block-end: var(--sp-08);
    }
    .text-body-display {
      width: 100%;
    }
    .--locations {
      margin-top: 0;
      margin-bottom: var(--sp-01);
      font-size: clamp(2.8rem, 3.5vw, 3.5rem);
      text-transform: uppercase;
    }

    .locations-header-container-adults-only {
      display: none;
    }
  }
  @media (max-width: 600px) {
    .locations-header {
      display: flex;
      flex-direction: column;
      align-items: center;
      border: var(--border-surface-dark-thinnest);
      border-radius: var(--br-03);
      background-color: var(--color-neutral-600-50);

      position: relative;
      padding-block: var(--sp-07) var(--sp-09);
      text-align: center;
    }
  }
</style>
