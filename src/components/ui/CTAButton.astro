---
const {
  text = "XXXX",
  href,
  ariaLabel,
  isExternal = false,
  hasShadow = false,
  onLight = false,
  isSecondary = false,
} = Astro.props;
---

<a
  rel={isExternal ? "noopener noreferrer" : undefined}
  target={isExternal ? "_blank" : undefined}
  href={href}
  class="cta-button"
  class:list={[
    "cta-button",
    {
      "card-shadow": hasShadow,
      "on-light": onLight,
      "secondary-btn": isSecondary,
    },
  ]}
  aria-label={ariaLabel}>{text}</a
>

<style>
  .cta-button {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    text-box: trim-both cap alphabetic;
    color: var(--color-cta-text);
    background-color: var(--color-cta);
    border: var(--border-cta);
    border-radius: var(--br-03);
    padding-block: var(--button-block-md);
    padding-inline: var(--button-inline-md);
    box-shadow: var(--card-shadow-neutral-medium);
    text-shadow: var(--text-shadow-color);
    transform: translateY(0);
    transition:
      color 200ms ease,
      background-color 150ms cubic-bezier(0.36, 0, 0.64, 1),
      transform 200ms ease-in,
      box-shadow 200ms ease-in;
  }
  .cta-button:focus-visible {
    transform: translateY(-3px);
    color: var(--color-cta-text-hover);
    background-color: var(--color-cta-hover);
    border: var(--border-cta-hover);
    text-shadow: none;
    box-shadow: 5px 8px 0 var(--color-neutral-600);
  }
  .card-shadow {
    box-shadow: 0 0 0 12px var(--color-surface-dark);
  }

  .on-light {
    /* display: block; */
    width: 100%;
    border-radius: var(--br-02);
    padding-block: var(--button-block-sm);
    padding-inline: var(--button-inline-sm);
    text-shadow: unset;
    box-shadow:
      0 0 0 3px var(--color-neutral-600),
      0 2px 0 2px var(--color-neutral-600);
    cursor: pointer;
    transform: translateY(0);
    text-align: center;
    transition:
      color 200ms ease,
      background-color 150ms cubic-bezier(0.36, 0, 0.64, 1),
      transform 150ms ease-in,
      box-shadow 200ms ease-in;
    /* flex: 1 1 auto; */
  }
  .on-light:focus-visible {
    transform: translateY(-2px);
    box-shadow:
      0 0 0 3px var(--color-neutral-600),
      3px 4px 0 3px var(--color-neutral-600);
  }
  .secondary-btn {
    background-color: var(--color-neutral-200);
    color: var(--color-secondary-200);
    border: 1px solid transparent;
  }

  @media (hover: hover) {
    .cta-button:hover {
      transform: translateY(-3px);
      color: var(--color-cta-text-hover);
      background-color: var(--color-cta-hover);
      border: var(--border-cta-hover);
      text-shadow: none;
      box-shadow: 5px 8px 0 var(--color-neutral-600);
    }
    .card-shadow:hover {
      box-shadow: 0 0 0 24px var(--color-surface-dark);
    }
    .on-light:hover {
      transform: translateY(-2px);
      box-shadow:
        0 0 0 3px var(--color-neutral-600),
        0 4px 0 3px var(--color-neutral-600);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-button {
      transition: none;
      transform: none;
    }
  }
</style>
